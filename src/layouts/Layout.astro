---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="System Engineer & Cloud Architect Portfolio" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<nav class="main-nav">
			<div class="nav-content">
				<a href="/" class="nav-logo">System Engineer</a>
				<button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu">
					<span></span>
					<span></span>
					<span></span>
				</button>
				<div class="nav-links" id="nav-links">
					<a href="/blog">Blog</a>
					<div class="social-links">
						<a href="https://github.com/kiquetal" target="_blank" rel="noopener noreferrer" class="social-link github" aria-label="GitHub">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.416-4.041-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
						</a>
						<a href="https://www.linkedin.com/in/kiquetal" target="_blank" rel="noopener noreferrer" class="social-link linkedin" aria-label="LinkedIn">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
						</a>
					</div>
					<a href="/contact" class="contact-btn">Contact</a>
					<div class="lang-switch-header">
						<button id="lang-en-header" class="active">🇬🇧 EN</button>
						<span class="separator">/</span>
						<button id="lang-es-header">🇵🇾 ES</button>
					</div>
				</div>
			</div>
		</nav>
		<slot />
		<div class="nav-backdrop" id="nav-backdrop"></div>
		<footer class="site-footer">
			<div class="footer-content">
				<div class="footer-links">
					<a href="/">Home</a>
					<a href="/blog">Blog</a>
					<a href="/contact">Contact</a>
				</div>
				<div class="footer-social">
					<a href="https://github.com/kiquetal" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.416-4.041-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
					</a>
					<a href="https://www.linkedin.com/in/kiquetal" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
					</a>
				</div>
				<p class="footer-copy">&copy; 2026 kiquetal.dev</p>
			</div>
		</footer>
	</body>
</html>

<script>
	const btnEnHeader = document.getElementById('lang-en-header');
	const btnEsHeader = document.getElementById('lang-es-header');

	function setLanguage(lang) {
		if (btnEnHeader && btnEsHeader) {
			if (lang === 'en') {
				btnEnHeader.classList.add('active');
				btnEsHeader.classList.remove('active');
			} else {
				btnEsHeader.classList.add('active');
				btnEnHeader.classList.remove('active');
			}
		}
		localStorage.setItem('preferred-lang', lang);
		window.dispatchEvent(new CustomEvent('languageChange', { detail: { lang } }));
	}

	if (btnEnHeader) btnEnHeader.addEventListener('click', () => setLanguage('en'));
	if (btnEsHeader) btnEsHeader.addEventListener('click', () => setLanguage('es'));

	const savedLang = localStorage.getItem('preferred-lang') || 'en';
	setLanguage(savedLang);

	// Mobile nav toggle
	const navToggle = document.getElementById('nav-toggle');
	const navLinks = document.getElementById('nav-links');
	const navBackdrop = document.getElementById('nav-backdrop');

	function closeNav() {
		navToggle?.classList.remove('active');
		navLinks?.classList.remove('open');
		navBackdrop?.classList.remove('active');
		document.body.style.overflow = '';
	}

	navToggle?.addEventListener('click', () => {
		const isOpen = navLinks?.classList.contains('open');
		if (isOpen) {
			closeNav();
		} else {
			navToggle.classList.add('active');
			navLinks?.classList.add('open');
			navBackdrop?.classList.add('active');
			document.body.style.overflow = 'hidden';
		}
	});

	navBackdrop?.addEventListener('click', closeNav);
	navLinks?.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', closeNav);
	});

	// Scroll shadow on nav
	const nav = document.querySelector('.main-nav');
	window.addEventListener('scroll', () => {
		if (window.scrollY > 10) {
			nav?.classList.add('scrolled');
		} else {
			nav?.classList.remove('scrolled');
		}
	}, { passive: true });
</script>

<style is:global>
	:root {
		--accent: 56, 189, 248;
		--accent-light: 186, 230, 253;
		--accent-dark: 14, 165, 233;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);

		--surface-0: #0f172a;
		--surface-1: rgba(255, 255, 255, 0.03);
		--surface-2: rgba(255, 255, 255, 0.06);
		--surface-hover: rgba(255, 255, 255, 0.08);

		--text-primary: #f8fafc;
		--text-secondary: #cbd5e1;
		--text-muted: #94a3b8;
		--text-faint: #64748b;

		--border-subtle: rgba(255, 255, 255, 0.08);
		--border-default: rgba(255, 255, 255, 0.12);

		--radius-sm: 6px;
		--radius-md: 10px;
		--radius-lg: 16px;
		--radius-full: 9999px;

		--transition-fast: 150ms ease;
		--transition-base: 250ms ease;
		--transition-slow: 400ms cubic-bezier(0.16, 1, 0.3, 1);

		--shadow-glow: 0 0 20px rgba(var(--accent), 0.15);
	}

	html {
		font-family: 'Inter', system-ui, sans-serif;
		background: var(--surface-0);
		background-image:
			radial-gradient(at 0% 0%, rgba(56, 189, 248, 0.12) 0px, transparent 50%),
			radial-gradient(at 100% 0%, rgba(139, 92, 246, 0.12) 0px, transparent 50%),
			radial-gradient(at 100% 100%, rgba(56, 189, 248, 0.08) 0px, transparent 50%),
			radial-gradient(at 0% 100%, rgba(139, 92, 246, 0.08) 0px, transparent 50%);
		background-attachment: fixed;
		scroll-behavior: smooth;
		scroll-padding-top: 5rem;
	}

	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	::selection {
		background: rgba(var(--accent), 0.3);
		color: var(--text-primary);
	}

	::-webkit-scrollbar {
		width: 6px;
	}

	::-webkit-scrollbar-track {
		background: transparent;
	}

	::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.12);
		border-radius: var(--radius-full);
	}

	::-webkit-scrollbar-thumb:hover {
		background: rgba(255, 255, 255, 0.2);
	}

	code {
		font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono, Courier New, monospace;
	}

	/* Navigation */
	.main-nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		background: rgba(15, 23, 42, 0.8);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		z-index: 100;
		border-bottom: 1px solid var(--border-subtle);
		transition: box-shadow var(--transition-base), border-color var(--transition-base);
	}

	.main-nav.scrolled {
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
		border-bottom-color: var(--border-default);
	}

	.nav-content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.875rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.nav-logo {
		font-weight: 700;
		color: var(--text-primary);
		text-decoration: none;
		font-size: 1.1rem;
		letter-spacing: -0.02em;
		transition: color var(--transition-fast);
	}

	.nav-logo:hover {
		color: rgb(var(--accent));
	}

	/* Hamburger */
	.nav-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px;
		z-index: 110;
	}

	.nav-toggle span {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--text-muted);
		border-radius: 2px;
		transition: all var(--transition-base);
		transform-origin: center;
	}

	.nav-toggle.active span:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}

	.nav-toggle.active span:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle.active span:nth-child(3) {
		transform: rotate(-45deg) translate(5px, -5px);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.nav-links > a:not(.contact-btn) {
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.925rem;
		transition: color var(--transition-fast);
	}

	.nav-links > a:not(.contact-btn):hover {
		color: var(--text-primary);
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.social-link {
		display: flex;
		align-items: center;
		color: var(--text-muted);
		transition: color var(--transition-fast);
	}

	.social-link:hover {
		color: var(--text-primary);
	}

	.social-link svg {
		width: 20px;
		height: 20px;
	}

	.contact-btn {
		background: rgba(var(--accent), 0.12);
		color: rgb(var(--accent));
		padding: 0.4rem 1rem;
		border-radius: var(--radius-full);
		font-size: 0.875rem;
		font-weight: 600;
		transition: all var(--transition-fast);
		border: 1px solid rgba(var(--accent), 0.2);
	}

	.contact-btn:hover {
		background: rgba(var(--accent), 0.2);
		transform: translateY(-1px);
	}

	.lang-switch-header {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.lang-switch-header button {
		background: none;
		border: none;
		color: var(--text-faint);
		cursor: pointer;
		font-size: 0.85rem;
		padding: 0.2rem 0.35rem;
		border-radius: var(--radius-sm);
		transition: all var(--transition-fast);
	}

	.lang-switch-header button:hover {
		color: var(--text-muted);
	}

	.lang-switch-header button.active {
		color: rgb(var(--accent));
	}

	.lang-switch-header .separator {
		color: var(--text-faint);
		font-size: 0.75rem;
	}

	/* Nav backdrop for mobile */
	.nav-backdrop {
		display: none;
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.5);
		z-index: 99;
		opacity: 0;
		transition: opacity var(--transition-base);
	}

	.nav-backdrop.active {
		display: block;
		opacity: 1;
	}

	/* Mobile nav */
	@media (max-width: 768px) {
		.nav-toggle {
			display: flex;
		}

		.nav-links {
			position: fixed;
			top: 0;
			right: -100%;
			width: min(280px, 80vw);
			height: 100vh;
			background: rgba(15, 23, 42, 0.98);
			backdrop-filter: blur(20px);
			-webkit-backdrop-filter: blur(20px);
			flex-direction: column;
			padding: 5rem 2rem 2rem;
			gap: 1.5rem;
			transition: right var(--transition-slow);
			border-left: 1px solid var(--border-subtle);
			align-items: flex-start;
			z-index: 105;
		}

		.nav-links.open {
			right: 0;
		}

		.nav-links > a:not(.contact-btn) {
			font-size: 1.05rem;
		}

		.social-links {
			padding-top: 1rem;
			border-top: 1px solid var(--border-subtle);
			width: 100%;
		}
	}

	/* Main content */
	main {
		padding-top: 5rem;
		flex: 1;
	}

	/* Footer */
	.site-footer {
		border-top: 1px solid var(--border-subtle);
		padding: 3rem 2rem;
		margin-top: auto;
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}

	.footer-links {
		display: flex;
		gap: 2rem;
	}

	.footer-links a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		transition: color var(--transition-fast);
	}

	.footer-links a:hover {
		color: var(--text-primary);
	}

	.footer-social {
		display: flex;
		gap: 1rem;
	}

	.footer-social a {
		color: var(--text-faint);
		transition: color var(--transition-fast);
		display: flex;
	}

	.footer-social a:hover {
		color: var(--text-primary);
	}

	.footer-social svg {
		width: 18px;
		height: 18px;
	}

	.footer-copy {
		color: var(--text-faint);
		font-size: 0.8rem;
		margin: 0;
	}

	/* Animations */
	@keyframes fadeSlideUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.7; }
	}

	.hidden {
		display: none !important;
	}
</style>
