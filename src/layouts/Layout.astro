---
import location from '../data/location.json';
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const { title, description = "System Engineer & Cloud Architect Portfolio", ogImage = "/og-default.png" } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=JetBrains+Mono:wght@300;400;500;700&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-screen flex flex-col bg-brand-bg text-brand-text-main font-mono antialiased selection:bg-brand-accent/30 selection:text-white">
		<div class="fixed inset-0 pointer-events-none z-[-1]" style="background-image: radial-gradient(circle at 50% 50%, #111827 0%, #0A0C10 100%);"></div>
		<header class="fixed top-0 w-full z-50 bg-brand-bg/80 backdrop-blur-md border-b border-brand-border/30">
			<div class="px-8 md:px-12 py-6 flex items-center justify-between transition-all duration-300" id="header-inner">
				<div class="flex flex-col">
					<a href="/" class="font-mono text-sm md:text-base tracking-[0.2em] font-bold uppercase text-brand-text-main">kiquetal</a>
					<div class="flex items-center gap-3">
						<span class="font-mono text-[11px] md:text-xs text-brand-accent uppercase tracking-[0.1em] font-medium">System Engineer</span>
						<div class="h-px w-4 bg-brand-border/30"></div>
						<a href="https://www.linkedin.com/in/kiquetal" target="_blank" rel="noopener noreferrer" class="group/link flex items-center gap-2 text-brand-text-muted hover:text-brand-accent transition-colors">
							<Icon name="ph:linkedin-logo-fill" size={16} />
							<span class="font-mono text-[9px] md:text-[10px] tracking-widest uppercase font-bold">LINKEDIN-PROFILE</span>
						</a>
					</div>
				</div>
				<nav class="hidden md:flex items-center gap-10">
					<a class={`nav-link ${currentPath === '/' ? 'text-brand-text-main border-b border-brand-accent pb-1' : 'text-brand-text-muted hover:text-brand-text-main'}`} href="/">
						<span class="lang-en">PHILOSOPHY</span>
						<span class="lang-es hidden">FILOSOFÍA</span>
					</a>
					<a class={`nav-link ${currentPath.startsWith('/blog') ? 'text-brand-text-main border-b border-brand-accent pb-1' : 'text-brand-text-muted hover:text-brand-text-main'}`} href="/blog">
						<span class="lang-en">BLOG</span>
						<span class="lang-es hidden">BLOG</span>
					</a>
					<a class={`nav-link ${currentPath === '/about' ? 'text-brand-text-main border-b border-brand-accent pb-1' : 'text-brand-text-muted hover:text-brand-text-main'}`} href="/about">
						<span class="lang-en">ABOUT</span>
						<span class="lang-es hidden">SOBRE MÍ</span>
					</a>
					<a class={`nav-link ${currentPath === '/contact' ? 'text-brand-text-main border-b border-brand-accent pb-1' : 'text-brand-text-muted hover:text-brand-text-main'}`} href="/contact">
						<span class="lang-en">CONTACT</span>
						<span class="lang-es hidden">CONTACTO</span>
					</a>
					
					<div class="flex items-center gap-2 ml-4 border-l border-brand-border/30 pl-4">
						<button id="lang-en-header" class="text-[9px] tracking-widest text-brand-text-muted hover:text-brand-accent uppercase transition-colors">EN</button>
						<span class="text-[9px] text-brand-border">/</span>
						<button id="lang-es-header" class="text-[9px] tracking-widest text-brand-text-muted hover:text-brand-accent uppercase transition-colors">ES</button>
					</div>
				</nav>

				<button id="mobile-menu-toggle" class="md:hidden flex items-center text-brand-text-main p-2 -mr-2" aria-label="Toggle Menu">
					<Icon name="ph:list" size={24} id="hamburger-icon" />
					<Icon name="ph:x" size={24} id="close-icon" class="hidden" />
				</button>
			</div>
		</header>

		<!-- Mobile Menu Overlay -->
		<div id="mobile-menu" class="fixed inset-0 z-40 bg-brand-bg/95 backdrop-blur-lg hidden pt-32 px-10">
			<nav class="flex flex-col gap-8">
				<a class={`text-xl tracking-[0.2em] font-medium transition-colors ${currentPath === '/' ? 'text-brand-accent' : 'text-brand-text-muted'}`} href="/">
					<span class="lang-en">PHILOSOPHY</span>
					<span class="lang-es hidden">FILOSOFÍA</span>
				</a>
				<a class={`text-xl tracking-[0.2em] font-medium transition-colors ${currentPath.startsWith('/blog') ? 'text-brand-accent' : 'text-brand-text-muted'}`} href="/blog">
					<span class="lang-en">BLOG</span>
					<span class="lang-es hidden">BLOG</span>
				</a>
				<a class={`text-xl tracking-[0.2em] font-medium transition-colors ${currentPath === '/about' ? 'text-brand-accent' : 'text-brand-text-muted'}`} href="/about">
					<span class="lang-en">ABOUT</span>
					<span class="lang-es hidden">SOBRE MÍ</span>
				</a>
				<a class={`text-xl tracking-[0.2em] font-medium transition-colors ${currentPath === '/contact' ? 'text-brand-accent' : 'text-brand-text-muted'}`} href="/contact">
					<span class="lang-en">CONTACT</span>
					<span class="lang-es hidden">CONTACTO</span>
				</a>
				
				<div class="flex items-center gap-6 mt-8 pt-8 border-t border-brand-border/30">
					<button id="lang-en-mobile" class="text-xs tracking-[0.3em] text-brand-text-muted uppercase transition-colors">ENGLISH</button>
					<span class="text-brand-border">/</span>
					<button id="lang-es-mobile" class="text-xs tracking-[0.3em] text-brand-text-muted uppercase transition-colors">ESPAÑOL</button>
				</div>
			</nav>
		</div>

		<slot />

		<div class="w-full border-t border-brand-border/30 px-8 md:px-12 py-6 flex flex-wrap justify-between items-center gap-4 bg-brand-bg/50 backdrop-blur-sm">
			<div class="flex items-center gap-8">
				<div class="flex items-center gap-2">
					<span class="text-[9px] text-brand-text-muted uppercase tracking-widest">Lat:</span>
					<span class="text-[9px] text-brand-text-main uppercase tracking-widest font-bold">{location.lat}</span>
				</div>
				<div class="flex items-center gap-2">
					<span class="text-[9px] text-brand-text-muted uppercase tracking-widest">Lon:</span>
					<span class="text-[9px] text-brand-text-main uppercase tracking-widest font-bold">{location.lon}</span>
				</div>
			</div>
			<div class="flex items-center gap-6">
				<span class="text-[9px] text-brand-text-muted uppercase tracking-widest flex items-center gap-2">
					<span class="inline-block w-1.5 h-1.5 rounded-full bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.8)] animate-pulse"></span>
					Node_Primary: Active
				</span>
				<span class="text-[9px] text-brand-text-muted uppercase tracking-widest">Uptime: 99.999%</span>
			</div>
		</div>

		<footer class="border-t border-brand-border/30 py-16 px-8 md:px-12 bg-brand-surface/50">
			<div class="flex flex-col md:flex-row justify-between items-center gap-10 max-w-7xl mx-auto w-full">
				<div class="text-[10px] tracking-[0.2em] text-brand-text-muted uppercase font-medium">
					© 2026 KIQUETAL — SYSTEMS RESILIENCE
				</div>
				<div class="flex gap-12">
					<a class="text-[10px] tracking-[0.2em] uppercase text-brand-text-main hover:text-brand-accent transition-colors underline decoration-brand-accent/20 underline-offset-8" href="https://github.com/kiquetal" target="_blank" rel="noopener noreferrer">GITHUB</a>
					<a class="text-[10px] tracking-[0.2em] uppercase text-brand-text-main hover:text-brand-accent transition-colors underline decoration-brand-accent/20 underline-offset-8" href="https://www.linkedin.com/in/kiquetal" target="_blank" rel="noopener noreferrer">LINKEDIN</a>
				</div>
				<div class="text-[10px] tracking-[0.2em] text-brand-text-muted uppercase font-medium">
					{location.city}, {location.country} / {location.label}
				</div>
			</div>
		</footer>

		<script>
			const btnEnHeader = document.getElementById('lang-en-header');
			const btnEsHeader = document.getElementById('lang-es-header');
			const btnEnMobile = document.getElementById('lang-en-mobile');
			const btnEsMobile = document.getElementById('lang-es-mobile');
			const mobileMenu = document.getElementById('mobile-menu');
			const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
			const hamburgerIcon = document.getElementById('hamburger-icon');
			const closeIcon = document.getElementById('close-icon');

			function setLanguage(lang) {
				const buttons = [
					{ btn: btnEnHeader, isEn: true },
					{ btn: btnEsHeader, isEn: false },
					{ btn: btnEnMobile, isEn: true },
					{ btn: btnEsMobile, isEn: false }
				];

				buttons.forEach(({ btn, isEn }) => {
					if (!btn) return;
					if ((isEn && lang === 'en') || (!isEn && lang === 'es')) {
						btn.classList.add('text-brand-accent', 'font-bold');
						btn.classList.remove('text-brand-text-muted');
					} else {
						btn.classList.remove('text-brand-accent', 'font-bold');
						btn.classList.add('text-brand-text-muted');
					}
				});

				// Toggle language-specific spans globally
				document.querySelectorAll('.lang-en').forEach(el => lang === 'en' ? el.classList.remove('hidden') : el.classList.add('hidden'));
				document.querySelectorAll('.lang-es').forEach(el => lang === 'es' ? el.classList.remove('hidden') : el.classList.add('hidden'));

				localStorage.setItem('preferred-lang', lang);
				window.dispatchEvent(new CustomEvent('languageChange', { detail: { lang } }));
			}

			if (btnEnHeader) btnEnHeader.addEventListener('click', () => setLanguage('en'));
			if (btnEsHeader) btnEsHeader.addEventListener('click', () => setLanguage('es'));
			if (btnEnMobile) btnEnMobile.addEventListener('click', () => setLanguage('en'));
			if (btnEsMobile) btnEsMobile.addEventListener('click', () => setLanguage('es'));

			if (mobileMenuToggle) {
				mobileMenuToggle.addEventListener('click', () => {
					const isHidden = mobileMenu.classList.contains('hidden');
					if (isHidden) {
						mobileMenu.classList.remove('hidden');
						hamburgerIcon.classList.add('hidden');
						closeIcon.classList.remove('hidden');
						document.body.style.overflow = 'hidden';
					} else {
						mobileMenu.classList.add('hidden');
						hamburgerIcon.classList.remove('hidden');
						closeIcon.classList.add('hidden');
						document.body.style.overflow = '';
					}
				});
			}

			// Close mobile menu when clicking a link
			mobileMenu?.querySelectorAll('a').forEach(link => {
				link.addEventListener('click', () => {
					mobileMenu.classList.add('hidden');
					hamburgerIcon.classList.remove('hidden');
					closeIcon.classList.add('hidden');
					document.body.style.overflow = '';
				});
			});

			const savedLang = localStorage.getItem('preferred-lang') || 'en';
			setLanguage(savedLang);

			// Scroll effects
			const header = document.querySelector('header');
			const headerInner = document.getElementById('header-inner');
			window.addEventListener('scroll', () => {
				if (window.scrollY > 20) {
					header?.classList.add('shadow-xl', 'bg-brand-bg/95');
					headerInner?.classList.replace('py-6', 'py-4');
				} else {
					header?.classList.remove('shadow-xl', 'bg-brand-bg/95');
					headerInner?.classList.replace('py-4', 'py-6');
				}
			}, { passive: true });
		</script>

		<style is:global>
			@tailwind base;
			@tailwind components;
			@tailwind utilities;

			@layer base {
				p {
					@apply leading-relaxed;
				}
				.hidden {
					display: none;
				}
			}

			@layer components {
				.nav-link {
					@apply font-mono text-[8px] md:text-xs tracking-[0.1em] md:tracking-[0.2em] font-medium transition-colors duration-300 uppercase;
				}
				
				.card-dark {
					background-color: theme('colors.brand-surface');
					border: 1px solid theme('colors.brand-border / 60%');
					@apply rounded-sm;
				}

				.sidebar-item {
					border-bottom: 1px solid theme('colors.brand-border / 50%');
					@apply py-4 last:border-0;
				}
			}

			.text-glow {
				text-shadow: 0 0 15px rgba(96, 165, 250, 0.3);
			}
			
			/* Standardized Scrollbar */
			::-webkit-scrollbar {
				width: 6px;
			}
			::-webkit-scrollbar-track {
				@apply bg-brand-bg;
			}
			::-webkit-scrollbar-thumb {
				background-color: theme('colors.brand-border');
				@apply rounded-full;
			}
			::-webkit-scrollbar-thumb:hover {
				background-color: theme('colors.brand-accent');
			}
		</style>
	</body>
</html>
