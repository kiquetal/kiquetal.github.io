---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title.en}>
	<main>
		<a href="/blog" class="back-link">← <span class="lang-en">Back</span><span class="lang-es hidden">Volver</span></a>
		</div>

		<article>
			{post.data.draft && (
				<div class="draft-banner">
					<span>🚧</span>
					<div>
						<strong class="lang-en">Under Development</strong>
						<strong class="lang-es hidden">En Desarrollo</strong>
						<p class="lang-en">This post is still being written and may be incomplete.</p>
						<p class="lang-es hidden">Este artículo aún está siendo escrito y puede estar incompleto.</p>
					</div>
				</div>
			)}
			<div class="post-meta">
				<span class="post-date lang-en">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
				<span class="post-date lang-es hidden">{post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
				{post.data.updated && (
					<>
						<span class="post-updated lang-en"> • Updated: {post.data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
						<span class="post-updated lang-es hidden"> • Actualizado: {post.data.updated.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
					</>
				)}
			</div>
			<h1 class="lang-en">{post.data.title.en}</h1>
			<h1 class="lang-es hidden">{post.data.title.es}</h1>

			{post.data.tags && (
				<div class="tags">
					{post.data.tags.map(tag => (
						<a href={`/blog/tag/${tag}`} class="tag">#{tag}</a>
					))}
				</div>
			)}

			{post.data.liveUrl && (
				<div class="live-demo-banner">
					<span class="lang-en">Check out the live demo:</span>
					<span class="lang-es hidden">Ver la demo en vivo:</span>
					<a href={post.data.liveUrl} target="_blank" class="demo-link">{post.data.liveUrl} ↗</a>
				</div>
			)}
			
			<div class="content">
				<Content />
			</div>
		</article>
	</main>
</Layout>

<script>
	const getLangElements = () => ({
		en: document.querySelectorAll('.lang-en'),
		es: document.querySelectorAll('.lang-es')
	});

	function setLanguage(lang) {
		const { en, es } = getLangElements();
		
		if (lang === 'en') {
			en.forEach(el => el.classList.remove('hidden'));
			es.forEach(el => el.classList.add('hidden'));
		} else {
			es.forEach(el => el.classList.remove('hidden'));
			en.forEach(el => el.classList.add('hidden'));
		}
	}

	window.addEventListener('languageChange', (e) => {
		setLanguage(e.detail.lang);
	});

	const savedLang = localStorage.getItem('preferred-lang') || 'en';
	setLanguage(savedLang);
</script>

<style>
	main {
		margin: auto;
		padding: 6rem 2rem 4rem;
		width: 100%;
		max-width: 720px;
		color: var(--text-secondary);
	}

	.draft-banner {
		background: linear-gradient(135deg, rgba(255, 152, 0, 0.1) 0%, rgba(255, 87, 34, 0.1) 100%);
		border: 2px solid #ff9800;
		border-radius: 8px;
		padding: 1.5rem;
		margin-bottom: 2rem;
		display: flex;
		gap: 1rem;
		align-items: flex-start;
	}

	.draft-banner > span:first-child {
		font-size: 2rem;
		line-height: 1;
	}

	.draft-banner strong {
		color: #ff9800;
		font-size: 1.1rem;
		display: block;
		margin-bottom: 0.5rem;
	}

	.draft-banner p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.back-link {
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 600;
		transition: all var(--transition-fast);
		display: inline-block;
		margin-bottom: 3rem;
	}

	.back-link:hover {
		color: var(--text-primary);
		transform: translateX(-3px);
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 2rem;
		line-height: 1.2;
	}

	.post-meta {
		margin-bottom: 1rem;
	}

	.post-date {
		font-size: 1rem;
		color: var(--text-faint);
	}

	.post-updated {
		font-size: 1rem;
		color: var(--text-faint);
		font-style: italic;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.tag {
		background: rgba(var(--accent), 0.1);
		padding: 0.25rem 0.75rem;
		border-radius: var(--radius-full);
		font-size: 0.875rem;
		color: rgb(var(--accent-light));
		font-weight: 500;
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.tag:hover {
		background: rgba(var(--accent), 0.2);
	}

	.live-demo-banner {
		background: rgba(var(--accent), 0.08);
		border: 1px solid rgba(var(--accent), 0.15);
		padding: 1rem;
		border-radius: var(--radius-md);
		margin-bottom: 2rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.demo-link {
		color: rgb(var(--accent));
		font-weight: 600;
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.demo-link:hover {
		color: rgb(var(--accent-light));
	}

	.content :global(h2) {
		color: var(--text-primary);
		font-size: 1.8rem;
		margin-top: 2.5rem;
		margin-bottom: 1.5rem;
	}

	.content :global(h3) {
		color: var(--text-primary);
		font-size: 1.5rem;
		margin-top: 2rem;
		margin-bottom: 1rem;
	}

	.content :global(p) {
		color: var(--text-secondary);
		line-height: 1.9;
		margin-bottom: 1.5rem;
		font-size: 1.1rem;
	}

	.content :global(a) {
		color: rgb(var(--accent));
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color var(--transition-fast);
	}

	.content :global(a:hover) {
		color: rgb(var(--accent-light));
	}

	.content :global(ul) {
		color: var(--text-secondary);
		line-height: 1.8;
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}

	.content :global(li) {
		margin-bottom: 0.5rem;
	}

	.content :global(pre) {
		background: rgba(15, 23, 42, 0.8);
		backdrop-filter: blur(8px);
		padding: 1.5rem;
		border-radius: var(--radius-md);
		margin-bottom: 1.5rem;
		overflow-x: auto;
		border: 1px solid var(--border-subtle);
	}

	.content :global(code) {
		font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
		font-size: 0.9em;
	}

	.content :global(.demo-box) {
		background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(139, 92, 246, 0.15));
		border: 1px solid rgba(139, 92, 246, 0.3);
		padding: 1.25rem;
		border-radius: var(--radius-lg);
		margin: 2rem 0;
	}

	.content :global(.demo-label) {
		font-weight: 600;
		color: #c4b5fd;
		margin-bottom: 0.75rem;
		font-size: 1.1rem;
	}

	.content :global(.demo-url) {
		display: block;
		color: var(--text-muted);
		text-decoration: none;
		font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
		font-size: 0.95rem;
		transition: color var(--transition-fast);
	}

	.content :global(.demo-url:hover) {
		color: #c4b5fd;
	}
</style>
