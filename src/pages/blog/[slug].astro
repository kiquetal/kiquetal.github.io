---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const translations = {
  en: {
    back: "Back to Index",
    updated: "Updated",
    liveDemo: "Live Instance",
    underDevelopment: "Draft Entry",
    draftWarning: "This system architectural record is currently being refined."
  },
  es: {
    back: "Volver al Índice",
    updated: "Actualizado",
    liveDemo: "Instancia en Vivo",
    underDevelopment: "Borrador",
    draftWarning: "Este registro arquitectónico del sistema está siendo refinado actualmente."
  }
};

const currentLang = 'en';
const t = translations[currentLang];
---

<Layout title={post.data.title.en} description={post.data.excerpt.en}>
	<main class="flex-grow flex flex-col px-8 md:px-16 pt-32 pb-20">
		<div class="max-w-4xl w-full mx-auto">
			<nav class="mb-16 flex items-center gap-6">
				<a href="/" class="font-mono text-[10px] tracking-[0.3em] text-brand-text-muted hover:text-brand-accent uppercase transition-all font-bold group flex items-center gap-2">
					<Icon name="ph:house-bold" size={14} class="group-hover:scale-110 transition-transform" />
					<span class="lang-en">HOME</span>
					<span class="lang-es hidden">INICIO</span>
				</a>
				<div class="h-px w-4 bg-brand-border/30"></div>
				<a href="/blog" class="font-mono text-[10px] tracking-[0.3em] text-brand-text-muted hover:text-brand-accent uppercase transition-all font-bold group flex items-center gap-2">
					<Icon name="ph:arrow-left-bold" size={14} class="group-hover:-translate-x-1 transition-transform" />
					<span class="lang-en">BACK TO ARCHIVE</span>
					<span class="lang-es hidden">VOLVER AL ARCHIVO</span>
				</a>
			</nav>

			<article class="blog-post">
				<header class="mb-16">
					<div class="flex items-center gap-4 mb-6">
						<span class="font-mono text-[10px] text-brand-text-muted uppercase tracking-[0.2em]">
							<span class="lang-en">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
							<span class="lang-es hidden">{post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
						</span>
						{post.data.updated && (
							<>
								<div class="h-[1px] w-4 bg-brand-border"></div>
								<span class="font-mono text-[9px] font-bold text-brand-accent uppercase tracking-[0.2em] border border-brand-accent/40 bg-brand-accent/10 px-3 py-1 rounded-full">
									<span class="lang-en">Updated: {post.data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</span>
									<span class="lang-es hidden">Actualizado: {post.data.updated.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</span>
								</span>
							</>
						)}
					</div>

					<h1 class="font-serif text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.1] tracking-tight mb-8 text-brand-text-main italic">
						<span class="lang-en">{post.data.title.en}</span>
						<span class="lang-es hidden">{post.data.title.es}</span>
					</h1>

					<div class="flex flex-wrap gap-4">
						{post.data.tags?.map(tag => (
							<a href={`/blog/tag/${tag}`} class="font-mono text-[9px] tracking-widest text-brand-text-muted hover:text-brand-accent uppercase transition-colors border border-brand-border/50 px-3 py-1 rounded-full">
								#{tag}
							</a>
						))}
					</div>
				</header>

				{post.data.draft && (
					<div class="mb-12 border border-yellow-500/30 bg-yellow-500/5 p-6 rounded-sm">
						<div class="flex items-center gap-4 mb-2">
							<div class="w-1.5 h-1.5 rounded-full bg-yellow-500 animate-pulse shadow-[0_0_8px_rgba(234,179,8,0.8)]"></div>
							<span class="font-mono text-[10px] tracking-[0.3em] text-yellow-500 uppercase font-bold">
								<span class="lang-en">In Progress / Under Development</span>
								<span class="lang-es hidden">En Progreso / Bajo Desarrollo</span>
							</span>
						</div>
						<p class="font-mono text-[11px] tracking-wider text-yellow-500/70 uppercase">
							<span class="lang-en">{t.draftWarning}</span>
							<span class="lang-es hidden">{translations.es.draftWarning}</span>
						</p>
					</div>
				)}

				{post.data.liveUrl && (
					<div class="mb-12 flex items-center gap-6 py-4 border-y border-brand-border/30">
						<span class="font-mono text-[9px] tracking-[0.3em] text-brand-text-muted uppercase">
							<span class="lang-en">{t.liveDemo}</span>
							<span class="lang-es hidden">{translations.es.liveDemo}</span>
						</span>
						<a href={post.data.liveUrl} target="_blank" class="font-mono text-[10px] tracking-widest text-brand-accent hover:text-brand-text-main transition-colors truncate">
							{post.data.liveUrl} ↗
						</a>
					</div>
				)}

				<div class="prose-custom">
					<Content />
				</div>
			</article>

			<!-- Newsletter / Subscriber Node -->
			<div class="border border-brand-border/30 bg-brand-bg/30 p-8 mt-24">
				<div class="mb-6">
					<h3 class="font-serif text-xl text-brand-text-main italic mb-2">
						<span class="lang-en">SYSTEM BROADCASTS</span>
						<span class="lang-es hidden">EMISIONES DEL SISTEMA</span>
					</h3>
					<p class="font-mono text-[10px] text-brand-text-muted uppercase tracking-[0.2em]">
						<span class="lang-en">Subscribe to receive telemetry logs directly in your inbox upon new entry compiles.</span>
						<span class="lang-es hidden">Suscríbete para recibir registros de telemetría en tu bandeja de entrada al compilar nuevas entradas.</span>
					</p>
				</div>

				<form
					id="subscribe-form"
					class="flex flex-col sm:flex-row gap-4 w-full"
				>
					<div class="flex-grow flex border border-brand-border/40 focus-within:border-brand-accent/50 bg-brand-bg/80 transition-colors">
						<span class="font-mono text-xs text-brand-text-muted/40 p-4 border-r border-brand-border/20 uppercase select-none">ADDR_</span>
						<input
							type="email"
							name="email"
							id="subscribe-email"
							placeholder="USER@HOST.COM"
							class="bg-transparent text-brand-text-main font-mono text-xs p-4 flex-grow focus:outline-none placeholder:text-brand-text-muted/30 uppercase tracking-widest"
							required
						/>
					</div>
					<button 
						type="submit" 
						id="subscribe-btn"
						class="bg-brand-accent/10 hover:bg-brand-accent/25 text-brand-accent font-mono text-[10px] tracking-[0.2em] uppercase font-bold px-8 py-4 border border-brand-accent/20 transition-all whitespace-nowrap"
					>
						<span class="lang-en">JOIN NODE</span>
						<span class="lang-es hidden">UNIRSE AL NODO</span>
					</button>
				</form>
				<p id="subscribe-status" class="font-mono text-[10px] tracking-[0.2em] uppercase mt-4 hidden"></p>
			</div>
		</div>
	</main>
</Layout>

<script>
	function setLanguage(lang: string) {
		const enElements = document.querySelectorAll('.lang-en');
		const esElements = document.querySelectorAll('.lang-es');
		
		if (lang === 'en') {
			enElements.forEach(el => el.classList.remove('hidden'));
			esElements.forEach(el => el.classList.add('hidden'));
		} else {
			esElements.forEach(el => el.classList.remove('hidden'));
			enElements.forEach(el => el.classList.add('hidden'));
		}
	}

	window.addEventListener('languageChange', (e: any) => {
		setLanguage(e.detail.lang);
	});

	const savedLang = localStorage.getItem('preferred-lang') || 'en';
	setLanguage(savedLang);

	// Newsletter subscription handler
	const form = document.getElementById('subscribe-form');
	const status = document.getElementById('subscribe-status');
	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const email = (document.getElementById('subscribe-email') as HTMLInputElement)?.value;
		const btn = document.getElementById('subscribe-btn') as HTMLButtonElement;
		const lang = localStorage.getItem('preferred-lang') || 'en';

		if (!email) return;
		btn.disabled = true;
		btn.textContent = '...';

		try {
			const res = await fetch('https://subscriber.kiquetal.workers.dev', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, language: lang }),
			});
			if (status) {
				status.classList.remove('hidden');
				if (res.ok) {
					status.textContent = lang === 'es' ? '✓ NODO CONECTADO' : '✓ NODE CONNECTED';
					status.classList.add('text-green-400');
				} else {
					status.textContent = lang === 'es' ? '✗ ERROR DE CONEXIÓN' : '✗ CONNECTION ERROR';
					status.classList.add('text-red-400');
				}
			}
		} catch {
			if (status) {
				status.classList.remove('hidden');
				status.textContent = '✗ NETWORK ERROR';
				status.classList.add('text-red-400');
			}
		} finally {
			btn.disabled = false;
			btn.innerHTML = `<span class="lang-en">JOIN NODE</span><span class="lang-es hidden">UNIRSE AL NODO</span>`;
			setLanguage(localStorage.getItem('preferred-lang') || 'en');
		}
	});
</script>

<style is:global>
	.prose-custom {
		@apply font-serif text-lg md:text-xl leading-relaxed text-brand-text-muted tracking-normal normal-case;
	}

	.prose-custom h2 {
		@apply font-serif text-4xl md:text-5xl tracking-tight text-brand-text-main mt-24 mb-10 italic;
	}

	.prose-custom h3 {
		@apply font-serif text-3xl md:text-4xl tracking-tight text-brand-text-main mt-16 mb-8 italic;
	}

	.prose-custom p {
		@apply mb-10 leading-relaxed;
	}

	.prose-custom a {
		@apply text-brand-accent underline decoration-brand-accent/20 underline-offset-8 hover:text-brand-text-main transition-colors font-bold font-mono text-sm uppercase;
	}

	.prose-custom ul, .prose-custom ol {
		@apply mb-10 ml-4 flex flex-col gap-4;
	}

	.prose-custom li {
		@apply relative pl-10;
	}

	.prose-custom li::before {
		content: "✦";
		@apply absolute left-0 text-brand-accent/40 text-sm;
	}

	.prose-custom pre {
		@apply bg-brand-surface-accent border border-brand-border p-6 md:p-10 rounded-sm my-16 overflow-x-auto shadow-2xl;
		font-size: 0.75rem; /* Smaller text for ASCII */
		line-height: 1.2;
	}

	.prose-custom code {
		@apply font-mono text-[0.8em] bg-brand-surface-accent px-2 py-1 rounded-sm text-brand-accent font-bold;
	}

	.prose-custom pre code {
		@apply bg-transparent p-0 text-[11px] md:text-sm leading-relaxed border-none text-brand-text-main font-medium normal-case tracking-tight;
	}
	
	.prose-custom img {
		@apply w-full max-w-full h-auto rounded-sm my-20 border border-brand-border/50 grayscale-[20%] hover:grayscale-0 transition-all duration-1000 opacity-90 hover:opacity-100 shadow-[0_20px_50px_rgba(0,0,0,0.5)];
	}

	.prose-custom img.img-small {
		@apply max-w-[60%] mx-auto my-12;
	}

	.prose-custom blockquote {
		@apply border-l-4 border-brand-accent/30 pl-10 my-16 italic text-brand-text-main font-serif text-2xl md:text-3xl leading-relaxed;
	}

	.prose-custom .demo-box {
		@apply p-10 my-16 bg-brand-surface border border-brand-border/60 rounded-sm flex flex-col gap-6 border-l-4 border-l-brand-accent/50;
	}

	.prose-custom .demo-box-small {
		@apply p-6 my-8 max-w-2xl;
	}

	.prose-custom .demo-label {
		@apply font-mono text-[11px] tracking-[0.4em] text-brand-accent uppercase font-bold;
	}

	.prose-custom .demo-url {
		@apply font-mono text-sm md:text-base tracking-widest text-brand-text-main hover:text-brand-accent transition-colors normal-case truncate block;
	}
</style>
