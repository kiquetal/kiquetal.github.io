---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { Page } from 'astro';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = await getCollection('blog');
  const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const allTags = [...new Set(sortedPosts.flatMap(post => post.data.tags || []))];
  
  const allMonths = [...new Set(sortedPosts.map(post => {
    const d = post.data.date;
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  }))].sort((a, b) => b.localeCompare(a));

  return paginate(sortedPosts, { 
    pageSize: 10,
    props: { allTags, allMonths, posts: sortedPosts }
  });
}

const { page, allTags, allMonths, posts } = Astro.props as { page: Page<any>, allTags: string[], allMonths: string[], posts: any[] };

const translations = {
  en: {
    title: "Architectural Record.",
    description: "Technical documentation and insights into ",
    descriptionHighlight: "Systems Architecture",
    back: "Back to Index",
    readArticle: "READ ARTICLE",
    recentEntries: "RECENT ENTRIES",
    olderEntries: "OLDER ENTRIES",
    node: "NODE",
    of: "OF",
    curatedTopics: "Curated Topics",
    dateArchive: "Time Machine"
  },
  es: {
    title: "Registro Arquitectónico.",
    description: "Documentación técnica y reflexiones sobre ",
    descriptionHighlight: "Arquitectura de Sistemas",
    back: "Volver al Índice",
    readArticle: "LEER ARTÍCULO",
    recentEntries: "ENTRADAS RECIENTES",
    olderEntries: "ENTRADAS ANTIGUAS",
    node: "NODO",
    of: "DE",
    curatedTopics: "Temas Seleccionados",
    dateArchive: "Archivo Temporal"
  }
};

const t = translations.en;
---

<Layout title="Blog — kiquetal">
	<main class="flex-grow flex flex-col px-8 md:px-16 pt-32 pb-20">
		<div class="max-w-7xl w-full mx-auto">
			<header class="mb-20 border-b border-brand-border pb-12">
				<h1 class="font-serif text-4xl md:text-6xl tracking-tight mb-4 text-brand-text-main italic">
					<span class="lang-en">{translations.en.title}</span>
					<span class="lang-es hidden">{translations.es.title}</span>
				</h1>
				<p class="font-mono text-[11px] tracking-[0.3em] text-brand-text-muted uppercase">
					<span class="lang-en">{translations.en.description}<span class="italic text-brand-accent text-glow">{translations.en.descriptionHighlight}</span>.</span>
					<span class="lang-es hidden">{translations.es.description}<span class="italic text-brand-accent text-glow">{translations.es.descriptionHighlight}</span>.</span>
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					{allTags.map(tag => (
						<a href={`/blog/tag/${tag}`} class="font-mono text-[9px] tracking-widest text-brand-text-muted hover:text-brand-accent uppercase transition-colors border border-brand-border/50 px-3 py-1 rounded-full">
							#{tag}
						</a>
					))}
				</div>
			</header>

			<div class="grid grid-cols-12 gap-12 lg:gap-20">
				<div class="col-span-12 lg:col-span-8">
					<div class="flex flex-col gap-24">
						{page.data.map(post => (
							<article class="group relative">
								<div class="flex flex-col md:flex-row gap-8 items-baseline">
									<span class="font-mono text-[10px] text-brand-text-muted uppercase tracking-[0.2em] whitespace-nowrap">
										<span class="lang-en">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
										<span class="lang-es hidden">{post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
									</span>
									<div class="flex-grow">
										{post.data.draft && (
											<div class="flex items-center gap-2 mb-4">
												<span class="flex h-1.5 w-1.5 rounded-full bg-yellow-500 animate-pulse"></span>
												<span class="font-mono text-[9px] tracking-[0.2em] text-yellow-500 uppercase font-bold">In Progress / Borrador</span>
											</div>
										)}
										<h2 class="font-serif text-3xl md:text-5xl tracking-tight group-hover:text-brand-accent transition-colors text-brand-text-main mb-6 italic leading-tight">
											<a href={`/blog/${post.slug}`}>
												<span class="lang-en">{post.data.title.en}</span>
												<span class="lang-es hidden">{post.data.title.es}</span>
											</a>
										</h2>
										<p class="font-mono text-[13px] leading-relaxed text-brand-text-muted uppercase tracking-wider mb-8">
											<span class="lang-en">{post.data.description?.en || post.data.excerpt?.en || "System architectural documentation."}</span>
											<span class="lang-es hidden">{post.data.description?.es || post.data.excerpt?.es || "Documentación arquitectónica del sistema."}</span>
										</p>
										<div class="flex items-center gap-6">
											<a href={`/blog/${post.slug}`} class="font-mono text-[9px] tracking-[0.3em] text-brand-text-main uppercase border-b border-brand-accent/30 pb-1 hover:text-brand-accent hover:border-brand-accent transition-all font-bold">
												<span class="lang-en">{t.readArticle}</span>
												<span class="lang-es hidden">{translations.es.readArticle}</span>
											</a>
											<div class="flex gap-4">
												{post.data.tags?.map(tag => (
													<span class="text-[9px] font-mono text-brand-text-muted/50 uppercase tracking-widest">#{tag}</span>
												))}
											</div>
										</div>
									</div>
								</div>
							</article>
						))}
					</div>

					<nav class="mt-32 flex justify-between items-center border-t border-brand-border pt-12">
						{page.url.prev ? (
							<a href={page.url.prev} class="font-mono text-[10px] tracking-[0.2em] text-brand-text-main uppercase hover:text-brand-accent transition-colors font-bold">
								<span class="lang-en">← {t.recentEntries}</span>
								<span class="lang-es hidden">← {translations.es.recentEntries}</span>
							</a>
						) : <div />}
						<span class="font-mono text-[10px] tracking-[0.2em] text-brand-text-muted uppercase">
							<span class="lang-en">{t.node}_{page.currentPage} {t.of} {page.lastPage}</span>
							<span class="lang-es hidden">{translations.es.node}_{page.currentPage} {translations.es.of} {page.lastPage}</span>
						</span>
						{page.url.next ? (
							<a href={page.url.next} class="font-mono text-[10px] tracking-[0.2em] text-brand-text-main uppercase hover:text-brand-accent transition-colors font-bold">
								<span class="lang-en">{t.olderEntries} →</span>
								<span class="lang-es hidden">{translations.es.olderEntries} →</span>
							</a>
						) : <div />}
					</nav>

					<!-- Newsletter / Subscriber Node -->
					<div class="border border-brand-border/30 bg-brand-bg/30 p-8 mt-24">
						<div class="mb-6">
							<h3 class="font-serif text-xl text-brand-text-main italic mb-2">
								<span class="lang-en">SYSTEM BROADCASTS</span>
								<span class="lang-es hidden">EMISIONES DEL SISTEMA</span>
							</h3>
							<p class="font-mono text-[10px] text-brand-text-muted uppercase tracking-[0.2em]">
								<span class="lang-en">Subscribe to receive telemetry logs directly in your inbox upon new entry compiles.</span>
								<span class="lang-es hidden">Suscríbete para recibir registros de telemetría en tu bandeja de entrada al compilar nuevas entradas.</span>
							</p>
						</div>

						<form
							id="subscribe-form"
							class="flex flex-col sm:flex-row gap-4 w-full"
						>
							<div class="flex-grow flex border border-brand-border/40 focus-within:border-brand-accent/50 bg-brand-bg/80 transition-colors">
								<span class="font-mono text-xs text-brand-text-muted/40 p-4 border-r border-brand-border/20 uppercase select-none">ADDR_</span>
								<input
									type="email"
									name="email"
									id="subscribe-email"
									placeholder="USER@HOST.COM"
									class="bg-transparent text-brand-text-main font-mono text-xs p-4 flex-grow focus:outline-none placeholder:text-brand-text-muted/30 tracking-widest"
									required
								/>
							</div>
							<button 
								type="submit" 
								id="subscribe-btn"
								class="bg-brand-accent/10 hover:bg-brand-accent/25 text-brand-accent font-mono text-[10px] tracking-[0.2em] uppercase font-bold px-8 py-4 border border-brand-accent/20 transition-all whitespace-nowrap"
							>
								<span class="lang-en">JOIN NODE</span>
								<span class="lang-es hidden">UNIRSE AL NODO</span>
							</button>
						</form>
						<p id="subscribe-status" class="font-mono text-[10px] tracking-[0.2em] uppercase mt-4 hidden"></p>
					</div>
				</div>

				<aside class="col-span-12 lg:col-span-4 space-y-20">
					<!-- Date Archive -->
					<div class="card-dark p-8 border-l-2 border-brand-accent/30">
						<div class="flex items-center gap-4 mb-10">
							<div class="h-[1px] w-8 bg-brand-border"></div>
							<span class="font-mono text-[9px] tracking-[0.3em] text-brand-text-muted uppercase font-bold">
								<span class="lang-en">{t.dateArchive}</span>
								<span class="lang-es hidden">{translations.es.dateArchive}</span>
							</span>
						</div>
						<div class="flex flex-col">
							{allMonths.map(month => {
								const [y, m] = month.split('-');
								const monthName = new Date(parseInt(y), parseInt(m)-1).toLocaleString('en-US', { month: 'long' });
								const monthNameEs = new Date(parseInt(y), parseInt(m)-1).toLocaleString('es-ES', { month: 'long' });
								return (
									<a href={`/blog/date/${month}`} class="group flex justify-between items-center py-3 border-b border-brand-border/30 last:border-0">
										<span class="font-mono text-[13px] tracking-widest text-brand-text-muted group-hover:text-brand-accent transition-colors uppercase">
											<span class="lang-en">{monthName} {y}</span>
											<span class="lang-es hidden">{monthNameEs} {y}</span>
										</span>
										<span class="font-mono text-[11px] text-brand-text-muted/50 group-hover:text-brand-text-main transition-colors">
											[{posts.filter(p => p.data.date.toISOString().startsWith(month)).length}]
										</span>
									</a>
								);
							})}
						</div>
					</div>

					<div class="card-dark p-8">
						<div class="flex items-center gap-4 mb-10">
							<div class="h-[1px] w-8 bg-brand-border"></div>
							<span class="font-mono text-[9px] tracking-[0.3em] text-brand-text-muted uppercase font-bold">
								<span class="lang-en">{t.curatedTopics}</span>
								<span class="lang-es hidden">{translations.es.curatedTopics}</span>
							</span>
						</div>
						<div class="flex flex-col">
							{allTags.map(tag => {
								const count = posts.filter(p => p.data.tags?.includes(tag)).length;
								return (
									<a href={`/blog/tag/${tag}`} class="group flex justify-between items-center py-3 border-b border-brand-border/30 last:border-0">
										<span class="font-mono text-[13px] tracking-widest text-brand-text-muted group-hover:text-brand-accent transition-colors uppercase">#{tag}</span>
										<span class="font-mono text-[11px] text-brand-text-muted/50 group-hover:text-brand-text-main transition-colors">[{count}]</span>
									</a>
								);
							})}
						</div>
					</div>
				</aside>
			</div>
		</div>
	</main>
</Layout>

<script>
	function setLanguage(lang: string) {
		const enElements = document.querySelectorAll('.lang-en');
		const esElements = document.querySelectorAll('.lang-es');
		
		if (lang === 'en') {
			enElements.forEach(el => el.classList.remove('hidden'));
			esElements.forEach(el => el.classList.add('hidden'));
		} else {
			esElements.forEach(el => el.classList.remove('hidden'));
			enElements.forEach(el => el.classList.add('hidden'));
		}
	}

	window.addEventListener('languageChange', (e: any) => {
		setLanguage(e.detail.lang);
	});

	const savedLang = localStorage.getItem('preferred-lang') || 'en';
	setLanguage(savedLang);

	// Newsletter subscription handler
	const form = document.getElementById('subscribe-form');
	const status = document.getElementById('subscribe-status');
	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const email = (document.getElementById('subscribe-email') as HTMLInputElement)?.value;
		const btn = document.getElementById('subscribe-btn') as HTMLButtonElement;
		const lang = localStorage.getItem('preferred-lang') || 'en';

		if (!email) return;
		btn.disabled = true;
		btn.textContent = '...';

		try {
			const res = await fetch('https://subscriber.kiquetal.workers.dev', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, language: lang }),
			});
			if (status) {
				status.classList.remove('hidden');
				if (res.ok) {
					status.textContent = lang === 'es' ? '✓ NODO CONECTADO' : '✓ NODE CONNECTED';
					status.classList.add('text-green-400');
				} else {
					status.textContent = lang === 'es' ? '✗ ERROR DE CONEXIÓN' : '✗ CONNECTION ERROR';
					status.classList.add('text-red-400');
				}
			}
		} catch {
			if (status) {
				status.classList.remove('hidden');
				status.textContent = '✗ NETWORK ERROR';
				status.classList.add('text-red-400');
			}
		} finally {
			btn.disabled = false;
			btn.innerHTML = `<span class="lang-en">JOIN NODE</span><span class="lang-es hidden">UNIRSE AL NODO</span>`;
			setLanguage(localStorage.getItem('preferred-lang') || 'en');
		}
	});
</script>
