---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
	);
	return paginate(posts, { pageSize: 3 });
}

const { page } = Astro.props;
const posts = page.data;
---

<Layout title="Blog - System Engineer">
	<main>
		<h1>Blog</h1>

		<div id="filter-status" class="filter-status hidden">
			<span class="lang-en">Filtering by tag: <span id="current-tag" class="highlight"></span> <a href="/blog" class="clear-filter">Clear</a></span>
			<span class="lang-es hidden">Filtrando por etiqueta: <span id="current-tag-es" class="highlight"></span> <a href="/blog" class="clear-filter">Borrar</a></span>
		</div>

		<div class="posts-grid">
			{posts.map(post => (
				<article class="post-card" data-tags={post.data.tags?.join(',') || ''}>
					<span class="post-date lang-en">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
					<span class="post-date lang-es hidden">{post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
					<h2 class="lang-en">{post.data.title.en}</h2>
					<h2 class="lang-es hidden">{post.data.title.es}</h2>
					
					<p class="lang-en">{post.data.excerpt.en}</p>
					<p class="lang-es hidden">{post.data.excerpt.es}</p>
					
					{post.data.tags && (
						<div class="tags">
							{post.data.tags.map(tag => (
								<a href={`/blog?tag=${tag}`} class="tag">#{tag}</a>
							))}
						</div>
					)}

					<a href={`/blog/${post.slug}`} class="read-more">
						<span class="lang-en">Read more →</span>
						<span class="lang-es hidden">Leer más →</span>
					</a>
				</article>
			))}
		</div>

		<nav class="pagination">
			{page.url.prev ? (
				<a href={page.url.prev} class="prev">
					<span class="lang-en">← Previous</span>
					<span class="lang-es hidden">← Anterior</span>
				</a>
			) : <span />}
			
			<span class="page-info">
				<span class="lang-en">Page {page.currentPage} of {page.lastPage}</span>
				<span class="lang-es hidden">Página {page.currentPage} de {page.lastPage}</span>
			</span>

			{page.url.next ? (
				<a href={page.url.next} class="next">
					<span class="lang-en">Next →</span>
					<span class="lang-es hidden">Siguiente →</span>
				</a>
			) : <span />}
		</nav>
	</main>
</Layout>

<script>
	const enElements = document.querySelectorAll('.lang-en');
	const esElements = document.querySelectorAll('.lang-es');

	// Handle Tag Filtering
	const urlParams = new URLSearchParams(window.location.search);
	const tag = urlParams.get('tag');
	const filterStatus = document.getElementById('filter-status');
	const currentTagSpan = document.getElementById('current-tag');
	const currentTagSpanEs = document.getElementById('current-tag-es');
	const posts = document.querySelectorAll('.post-card');

	if (tag) {
		filterStatus.classList.remove('hidden');
		if (currentTagSpan) currentTagSpan.textContent = '#' + tag;
		if (currentTagSpanEs) currentTagSpanEs.textContent = '#' + tag;

		posts.forEach(post => {
			const postTags = (post.getAttribute('data-tags') || '').split(',');
			if (!postTags.includes(tag)) {
				(post as HTMLElement).style.display = 'none';
			}
		});
	}

	function setLanguage(lang) {
		if (lang === 'en') {
			enElements.forEach(el => el.classList.remove('hidden'));
			esElements.forEach(el => el.classList.add('hidden'));
		} else {
			esElements.forEach(el => el.classList.remove('hidden'));
			enElements.forEach(el => el.classList.add('hidden'));
		}
	}

	window.addEventListener('languageChange', (e) => {
		setLanguage(e.detail.lang);
	});

	const savedLang = localStorage.getItem('preferred-lang') || 'en';
	setLanguage(savedLang);
</script>

<style>
	main {
		margin: auto;
		padding: 6rem 2rem 4rem;
		width: 100%;
		max-width: 800px;
		color: var(--text-secondary);
	}

	.header-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 4rem;
	}

	h1 {
		font-size: 3rem;
		font-weight: 700;
		margin: 0;
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.posts-grid {
		display: grid;
		gap: 2rem;
	}

	.post-card {
		background: var(--surface-1);
		border: 1px solid var(--border-default);
		border-left: 3px solid transparent;
		padding: 2rem;
		border-radius: var(--radius-lg);
		transition: all var(--transition-base);
		animation: fadeSlideUp 0.5s ease both;
	}

	.post-card:nth-child(1) { animation-delay: 0s; }
	.post-card:nth-child(2) { animation-delay: 0.1s; }
	.post-card:nth-child(3) { animation-delay: 0.2s; }

	.post-card:hover {
		transform: translateY(-2px);
		background: var(--surface-hover);
		border-left-color: rgb(var(--accent));
		box-shadow: var(--shadow-glow);
	}

	.post-date {
		font-size: 0.875rem;
		color: var(--text-faint);
	}

	h2 {
		margin: 0.5rem 0 1rem;
		font-size: 1.5rem;
		color: var(--text-primary);
	}

	p {
		color: var(--text-muted);
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.read-more {
		color: rgb(var(--accent));
		text-decoration: none;
		font-weight: 600;
		display: inline-block;
		transition: color var(--transition-fast);
	}

	.read-more:hover {
		color: rgb(var(--accent-light));
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.tag {
		background: rgba(var(--accent), 0.1);
		padding: 0.25rem 0.75rem;
		border-radius: var(--radius-full);
		font-size: 0.875rem;
		color: rgb(var(--accent-light));
		font-weight: 500;
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.tag:hover {
		background: rgba(var(--accent), 0.2);
	}

	.filter-status {
		margin-bottom: 2rem;
		padding: 1rem;
		background: rgba(var(--accent), 0.1);
		border: 1px solid rgba(var(--accent), 0.2);
		border-radius: var(--radius-md);
		color: var(--text-secondary);
	}

	.highlight {
		font-weight: bold;
		color: rgb(var(--accent));
	}

	.clear-filter {
		margin-left: 1rem;
		color: var(--text-muted);
		font-size: 0.9em;
	}

	.clear-filter:hover {
		color: var(--text-secondary);
	}

	.pagination {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border-subtle);
	}

	.pagination a {
		color: rgb(var(--accent));
		text-decoration: none;
		font-weight: 600;
		background: var(--surface-1);
		padding: 0.5rem 1.25rem;
		border-radius: var(--radius-full);
		border: 1px solid var(--border-default);
		transition: all var(--transition-fast);
	}

	.pagination a:hover {
		background: var(--surface-hover);
		border-color: rgba(var(--accent), 0.3);
	}

	.page-info {
		color: var(--text-muted);
		font-size: 0.875rem;
	}

	.hidden {
		display: none;
	}
</style>
