---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — kiquetal" description="Page not found.">
	<main class="flex-grow flex flex-col items-center justify-center px-8 pt-32 pb-20 text-center">
		<span class="font-mono text-[9px] tracking-[0.6em] text-brand-text-muted uppercase mb-8">Signal_Status: NOT_FOUND</span>
		<h1 class="font-serif text-[clamp(4rem,15vw,10rem)] leading-none tracking-tight text-brand-text-main italic mb-4">404</h1>
		<p class="font-mono text-[11px] tracking-[0.3em] text-brand-text-muted uppercase mb-16">The requested node does not exist in this system.</p>
		<a href="/" class="font-mono text-[10px] tracking-[0.4em] uppercase border border-brand-accent/30 px-8 py-4 text-brand-accent hover:bg-brand-accent hover:text-brand-bg transition-all">
			Return to Origin
		</a>
	</main>
</Layout>
