---
import Layout from '../layouts/Layout.astro';

const translations = {
  en: {
    title: "Initiate ",
    titleItalic: "Protocol",
    titleSuffix: ".",
    description: "Whether it's a systems architecture inquiry or a potential collaboration, all signals are welcome. My response latency typically ranges from 12 to 24 hours.",
    nameLabel: "Identifier",
    emailLabel: "Return Address",
    messageLabel: "Payload",
    submitBtn: "Transmit Message",
    sending: "Transmitting...",
    success: "Signal received and acknowledged.",
    error: "Transmission failure. Please re-attempt."
  },
  es: {
    title: "Iniciar ",
    titleItalic: "Protocolo",
    titleSuffix: ".",
    description: "Ya sea una consulta de arquitectura de sistemas o una posible colaboración, todas las señales son bienvenidas. Mi latencia de respuesta suele oscilar entre 12 y 24 horas.",
    nameLabel: "Identificador",
    emailLabel: "Dirección de Retorno",
    messageLabel: "Carga Útil",
    submitBtn: "Transmitir Mensaje",
    sending: "Transmitiendo...",
    success: "Señal recibida y reconocida.",
    error: "Fallo en la transmisión. Por favor, reintente."
  }
};
---

<Layout title="Contact — kiquetal" description="Get in touch for systems architecture inquiries or collaboration.">
	<main class="flex-grow flex flex-col justify-center px-8 md:px-16 pt-32 pb-20">
		<div class="max-w-7xl w-full mx-auto">
			<div class="mb-16">
				<h1 class="font-serif text-[clamp(2.5rem,8vw,8rem)] leading-[0.9] tracking-tight mb-16">
                    <span id="title-text">{translations.en.title}</span> <br/>
					<span class="italic text-brand-accent text-glow" id="title-italic">{translations.en.titleItalic}</span>
					<span id="title-suffix">{translations.en.titleSuffix}</span>
				</h1>
				
				<div class="grid grid-cols-12 gap-8">
					<div class="col-start-1 md:col-start-7 col-span-12 md:col-span-5">
						<p class="font-serif text-xl md:text-2xl leading-relaxed text-brand-text-main mb-12 italic" id="subtitle-text">
                            {translations.en.description}
                        </p>

						<form id="contact-form" class="flex flex-col gap-10">
							<div class="group border-b border-brand-border/50 focus-within:border-brand-accent/50 transition-colors pb-2">
								<label for="name" class="block text-[9px] tracking-[0.3em] text-brand-text-muted uppercase mb-2 group-focus-within:text-brand-accent transition-colors font-bold" id="name-label">
									{translations.en.nameLabel}
								</label>
								<input 
									type="text" 
									id="name" 
									name="name" 
									required 
									class="w-full bg-transparent border-none p-0 font-mono text-xs tracking-widest focus:ring-0 text-brand-text-main placeholder:text-brand-border/50"
									placeholder="NAME / ORG"
								/>
							</div>

							<div class="group border-b border-brand-border/50 focus-within:border-brand-accent/50 transition-colors pb-2">
								<label for="email" class="block text-[9px] tracking-[0.3em] text-brand-text-muted uppercase mb-2 group-focus-within:text-brand-accent transition-colors font-bold" id="email-label">
									{translations.en.emailLabel}
								</label>
								<input 
									type="email" 
									id="email" 
									name="email" 
									required 
									class="w-full bg-transparent border-none p-0 font-mono text-xs tracking-widest focus:ring-0 text-brand-text-main placeholder:text-brand-border/50"
									placeholder="EMAIL@DOMAIN.COM"
								/>
							</div>

							<div class="group border-b border-brand-border/50 focus-within:border-brand-accent/50 transition-colors pb-2">
								<label for="message" class="block text-[9px] tracking-[0.3em] text-brand-text-muted uppercase mb-2 group-focus-within:text-brand-accent transition-colors font-bold" id="message-label">
									{translations.en.messageLabel}
								</label>
								<textarea 
									id="message" 
									name="message" 
									rows="4" 
									required 
									class="w-full bg-transparent border-none p-0 font-mono text-xs tracking-widest focus:ring-0 text-brand-text-main placeholder:text-brand-border/50 resize-none"
									placeholder="YOUR MESSAGE DATA..."
								></textarea>
							</div>

							<div class="flex flex-col gap-6">
								<button type="submit" id="submit-btn" class="font-mono text-[10px] tracking-[0.4em] text-brand-accent uppercase border border-brand-accent/30 px-8 py-4 hover:bg-brand-accent hover:text-brand-bg transition-all self-start font-bold">
									{translations.en.submitBtn}
								</button>

								<div id="form-status" class="text-[9px] tracking-[0.2em] uppercase hidden"></div>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script define:vars={{ translations }}>
	let currentLang = localStorage.getItem('preferred-lang') || 'en';

	function setLanguage(lang) {
		currentLang = lang;
		const t = translations[lang];
		
		const titleText = document.getElementById('title-text');
		if (titleText) titleText.textContent = t.title;
		
		const titleItalic = document.getElementById('title-italic');
		if (titleItalic) titleItalic.textContent = t.titleItalic;

		const titleSuffix = document.getElementById('title-suffix');
		if (titleSuffix) titleSuffix.textContent = t.titleSuffix;

		const subtitleText = document.getElementById('subtitle-text');
		if (subtitleText) subtitleText.textContent = t.description;

		const nameLabel = document.getElementById('name-label');
		if (nameLabel) nameLabel.textContent = t.nameLabel;

		const emailLabel = document.getElementById('email-label');
		if (emailLabel) emailLabel.textContent = t.emailLabel;

		const messageLabel = document.getElementById('message-label');
		if (messageLabel) messageLabel.textContent = t.messageLabel;

		const submitBtn = document.getElementById('submit-btn');
		if (submitBtn) submitBtn.textContent = t.submitBtn;
	}

	window.addEventListener('languageChange', (e) => {
		setLanguage(e.detail.lang);
	});

	setLanguage(currentLang);

	// Form Submission Logic
	const form = document.getElementById('contact-form');
	const statusDiv = document.getElementById('form-status');
	const submitBtn = document.getElementById('submit-btn');

	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const t = translations[currentLang];
			
			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.textContent = t.sending;
			}
			
			if (statusDiv) {
				statusDiv.classList.add('hidden');
				statusDiv.className = 'text-[9px] tracking-[0.2em] uppercase hidden';
			}

			const formData = new FormData(form);
			const rawData = Object.fromEntries(formData);

			const resendPayload = {
				from: "contact@kiquetal.dev",
				to: "hi@kiquetal.dev",
				subject: `New Contact from ${rawData.name}`,
				html: `
					<p><strong>Name:</strong> ${rawData.name}</p>
					<p><strong>Email:</strong> ${rawData.email}</p>
					<p><strong>Message:</strong></p>
					<p>${rawData.message.replace(/\n/g, '<br>')}</p>
				`,
				reply_to: rawData.email
			};

			try {
				const response = await fetch('https://emailer.kiquetal.dev', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify(resendPayload),
				});

				if (response.ok) {
					if (statusDiv) {
						statusDiv.textContent = t.success;
						statusDiv.classList.remove('hidden');
						statusDiv.classList.add('text-green-500');
					}
					form.reset();
				} else {
					throw new Error('Network response was not ok');
				}
			} catch (error) {
				if (statusDiv) {
					statusDiv.textContent = t.error;
					statusDiv.classList.remove('hidden');
					statusDiv.classList.add('text-red-500');
				}
			} finally {
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.textContent = t.submitBtn;
				}
			}
		});
	}
</script>
