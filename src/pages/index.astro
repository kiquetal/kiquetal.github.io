    description: '"Todo falla, todo el tiempo." — Werner Vogels, CTO @ AWS. La ingeniería es el arte de construir sistemas que prosperan ante la presencia de fallos.',
    manifesto: "Manifiesto de Sistemas v.1.0",
    cta: "Ver Credenciales",
    contact: "Contáctame",
    certificationsTitle: "Certificaciones Profesionales",
    viewProfile: "Puedes ver mi perfil aquí -> ",
    cert1: "AWS Solutions Architect Professional",
    cert2: "AWS Solutions Architect Associate",
    cert3: "AWS Developer Associate",
    cert4: "Certified Kubernetes Application Developer",
    cert5: "Oracle Certified Professional: Java",
    certCredly: "Perfil de Credly",
    demosTitle: "Demos en Vivo",
    demo1Title: "Encriptación de Extremo a Extremo con Quarkus",
    demo1Desc: "Encriptación segura de extremo a extremo usando Quarkus con envelope encryption.",
    demo5Title: "Speech-to-Text con Whisper y F#",
    demo5Desc: "Conversión de voz a texto usando el modelo Whisper de OpenAI implementado en F#.",
    demoLabel: "Ver Demo",
    blogLabel: "Leer Artículo",
    visitorsLabel: "visitantes",
    techTitle: "Arsenal Técnico",
    tech1Title: "Sistemas Distribuidos",
    tech1Desc: "Kubernetes, Istio, NATS y Spiffe para infraestructuras resilientes.",
    tech2Title: "Desarrollo Cloud Native",
    tech2Desc: "Quarkus, Java y Go para servicios backend de alto rendimiento.",
    tech3Title: "Seguridad y Ops",
    tech3Desc: "Encriptación E2E, Spire, AWS y GitOps para pipelines seguros.",
    coreTitle: "Núcleo Técnico y Ops",
    coreJava: "Reactividad / Quarkus",
    coreGo: "Herramientas Distribuidas",
    coreK8s: "Orquestación",
    coreAws: "Infraestructura Cloud",
