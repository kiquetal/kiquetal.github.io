const techStack = [
  { id: 'tech1', icon: 'ph:circles-three-plus-bold' },
  { id: 'tech2', icon: 'ph:code-bold' },
  { id: 'tech3', icon: 'ph:shield-check-bold' }
];

const demos = [
  {
    id: 'demo1',
    icon: 'ph:lock-key-bold',
    liveUrl: 'https://e2equarks.kiquetal.dev/whisper',
    blogUrl: '/blog/2026-02-13-e2s-encryption-with-quarkus'
  },
  {
    id: 'demo5',
    icon: 'ph:microphone-bold',
    liveUrl: '/unpublished-endpoint?blog=/blog/speech-to-text-whisper-fsharp',
    blogUrl: '/blog/speech-to-text-whisper-fsharp'
  }
];

const currentLang = 'en';
const t = translations[currentLang];
---

<Layout title={t.title} description="Everything fails, all the time. Engineering is the art of building systems that thrive in the presence of failure.">
	<main class="flex-grow flex flex-col justify-center px-8 md:px-16 pt-32 pb-20">
		<div class="max-w-7xl w-full mx-auto">
			<div class="relative mb-16 md:mb-32 pt-8 md:pt-16">
				<!-- Background Ambient Glow -->
				<div class="absolute -top-24 left-1/2 -translate-x-1/2 w-full max-w-4xl h-96 bg-brand-accent/5 blur-[120px] rounded-full pointer-events-none"></div>
				
				<div class="relative group">
					<div class="absolute -inset-4 bg-brand-accent/5 rounded-xl blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
					<div class="relative aspect-[16/9] lg:aspect-[21/9] w-full card-dark overflow-hidden border-brand-border/40 transition-all duration-1000 shadow-[0_0_100px_rgba(44,62,74,0.3)]">
						<div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-5 mix-blend-overlay"></div>
						<img src="https://api.dicebear.com/7.x/shapes/svg?seed=ultra-complex-architecture&backgroundColor=1C1917&shape1Color=E7A66A&shape2Color=3D3835&shape3Color=A8A29E&shape1Color=E7A66A" alt="System Complexity Visualization" class="w-full h-full object-cover scale-110 group-hover:scale-100 transition-all duration-[3000ms] ease-out opacity-90" />
						
						<!-- Overlays -->
						<div class="absolute inset-0 bg-gradient-to-t from-brand-bg/90 via-transparent to-transparent"></div>
						<div class="absolute inset-0 bg-gradient-to-r from-brand-bg/40 via-transparent to-brand-bg/40"></div>
						
						<!-- Metadata Labels -->
						<div class="absolute top-4 left-4 md:top-8 md:left-8 flex flex-col gap-2">
							<div class="h-0.5 w-8 md:w-12 bg-brand-accent/60"></div>
							<span class="font-mono text-[7px] md:text-[9px] tracking-[0.4em] md:tracking-[0.6em] text-brand-accent uppercase font-bold">Architecture_State: NOMINAL</span>
						</div>

						<div class="absolute top-4 right-4 md:top-8 md:right-8 flex items-center gap-2 md:gap-3">
							<span class="hidden sm:inline font-mono text-[8px] text-brand-text-muted uppercase tracking-widest">Active_Nodes</span>
							<div class="flex gap-1">
								<div class="w-1 h-1 bg-brand-accent"></div>
								<div class="w-1 h-1 bg-brand-accent animate-pulse"></div>
								<div class="w-1 h-1 bg-brand-accent"></div>
							</div>
						</div>

						<div class="absolute bottom-4 left-4 right-4 md:bottom-8 md:left-8 md:right-8 flex justify-between items-end">
							<div class="space-y-4">
								<div class="flex gap-6 md:gap-12">
									<div class="flex flex-col gap-1">
										<span class="font-mono text-[7px] md:text-[8px] text-brand-text-muted uppercase tracking-widest">Buffer_Sync</span>
										<span class="font-mono text-[8px] md:text-[10px] text-brand-text-main uppercase font-bold">OPTIMIZED</span>
									</div>
									<div class="flex flex-col gap-1">
										<span class="font-mono text-[7px] md:text-[8px] text-brand-text-muted uppercase tracking-widest">Entropy_Factor</span>
										<span class="font-mono text-[8px] md:text-[10px] text-brand-text-main uppercase font-bold">0.0024_Σ</span>
									</div>
									<div class="hidden md:flex flex-col gap-1">
										<span class="font-mono text-[8px] text-brand-text-muted uppercase tracking-widest">System_Auth</span>
										<span class="font-mono text-[10px] text-brand-text-main uppercase font-bold">CERTIFIED</span>
									</div>
								</div>
							</div>
							<div class="hidden sm:flex flex-col items-end gap-3">
								<span class="font-mono text-[8px] text-brand-text-muted uppercase tracking-[0.2em]">Core_System_Mapping</span>
								<div class="h-1 w-24 md:w-32 bg-brand-border/30 overflow-hidden rounded-full">
									<div class="h-full bg-brand-accent w-2/3 animate-[pulse_2s_infinite]"></div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-12 gap-8 lg:gap-16">
					<div class="col-span-12 lg:col-span-7">
						<div class="flex flex-col gap-8 mb-12">
							<p class="font-serif text-xl md:text-3xl leading-relaxed text-brand-text-main italic" id="description-text">
								{t.description}
							</p>
						</div>
						
						<div class="flex flex-wrap gap-8 items-center border-t border-brand-border pt-12">
							<div class="visitor-counter flex items-center gap-2">
								<span class="font-mono text-[10px] text-brand-text-muted uppercase tracking-widest flex items-center gap-2">
									<span class="inline-block w-1.5 h-1.5 rounded-full bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.8)] animate-pulse"></span>
									<span id="visitor-count" class="text-brand-text-main font-bold text-glow">...</span>
									<span id="visitors-label-text">{t.visitorsLabel}</span>
								</span>
							</div>

							{latestPost && (
								<div class="latest-update flex items-center gap-4">
									<div class="h-[1px] w-4 bg-brand-border"></div>
									<a href={`/blog/${latestPost.slug}`} class="font-mono text-[10px] tracking-[0.2em] text-brand-text-main uppercase hover:text-brand-accent transition-colors group flex items-center gap-1">
										<span id="latest-update-label" class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-2 py-0.5 rounded-sm font-semibold tracking-wider mr-1 text-[9px] shadow-[0_0_12px_rgba(16,185,129,0.1)] uppercase">{t.latestUpdate}</span>
										<span id="latest-post-title" class="group-hover:underline underline-offset-4"
											data-title-en={latestPost.data.title.en}
											data-title-es={latestPost.data.title.es}>
											{latestPost.data.title[currentLang]}
										</span>
									</a>
								</div>
							)}
						</div>
					</div>

					<div class="col-span-12 lg:col-span-5">
						<div class="card-dark p-8 border-l-2 border-l-brand-accent/50">
							<h3 class="font-mono text-[10px] tracking-[0.3em] uppercase text-brand-text-main mb-8 flex items-center gap-3 font-bold" id="core-title-text">
								<span class="h-px w-6 bg-brand-accent/40"></span> {t.coreTitle}
							</h3>
							<div class="space-y-2">
								<div class="sidebar-item flex justify-between items-center">
									<span class="text-[9px] text-brand-accent/70 tracking-[0.2em] font-bold uppercase">Java</span>
									<span class="font-serif text-lg italic text-brand-text-main" id="core-java-text">{t.coreJava}</span>
								</div>
								<div class="sidebar-item flex justify-between items-center">
									<span class="text-[9px] text-brand-accent/70 tracking-[0.2em] font-bold uppercase">Go</span>
									<span class="font-serif text-lg italic text-brand-text-main" id="core-go-text">{t.coreGo}</span>
								</div>
								<div class="sidebar-item flex justify-between items-center">
									<span class="text-[9px] text-brand-accent/70 tracking-[0.2em] font-bold uppercase">Kubernetes</span>
									<span class="font-serif text-lg italic text-brand-text-main" id="core-k8s-text">{t.coreK8s}</span>
								</div>
								<div class="sidebar-item flex justify-between items-center">
									<span class="text-[9px] text-brand-accent/70 tracking-[0.2em] font-bold uppercase">AWS</span>
									<span class="font-serif text-lg italic text-brand-text-main" id="core-aws-text">{t.coreAws}</span>
								</div>
							</div>
							<a href="#certifications" class="mt-8 block text-center border border-brand-accent/30 py-4 font-mono text-[10px] tracking-[0.25em] uppercase hover:bg-brand-accent hover:text-brand-bg transition-all duration-300 font-bold text-brand-accent" id="view-certs-text">
								{t.viewCerts}
							</a>
						</div>
					</div>
				</div>
			</div>

			<!-- Demos Section -->
			<section id="demos" class="mt-32 border-t border-brand-border pt-20">
				<h2 class="font-mono text-[13px] tracking-[0.4em] text-brand-text-muted uppercase mb-12 font-bold" id="demos-title-text">{t.demosTitle}</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
					{demos.map(demo => (
						<div class="card-dark p-8 group hover:border-brand-accent/50 transition-all duration-500">
							<div class="flex items-start justify-between mb-6">
								<div class="flex items-center gap-4">
									<Icon name={demo.icon} class="text-brand-accent group-hover:scale-110 transition-transform" size={24} />
									<h3 class="text-xs tracking-[0.2em] uppercase font-bold text-brand-text-main" id={`${demo.id}-title-text`}>{t[`${demo.id}Title`]}</h3>
								</div>
								<div class="flex gap-4">
									<a href={demo.liveUrl} target="_blank" class="text-[9px] tracking-widest text-brand-text-muted hover:text-brand-accent uppercase transition-colors">
										<span class="lang-en">{translations.en.liveBtn}</span>
										<span class="lang-es hidden">{translations.es.liveBtn}</span>
									</a>
									<a href={demo.blogUrl} class="text-[9px] tracking-widest text-brand-text-muted hover:text-brand-accent uppercase transition-colors">
										<span class="lang-en">{translations.en.detailsBtn}</span>
										<span class="lang-es hidden">{translations.es.detailsBtn}</span>
									</a>
								</div>
							</div>
							<p class="text-[11px] leading-relaxed text-brand-text-muted uppercase tracking-widest" id={`${demo.id}-desc-text`}>
								{t[`${demo.id}Desc`]}
							</p>
						</div>
					))}
				</div>
			</section>

			<!-- Tech Stack Section -->
			<section id="tech-stack" class="mt-32 border-t border-brand-border pt-20">
				<h2 class="font-mono text-[13px] tracking-[0.4em] text-brand-text-muted uppercase mb-16 font-bold" id="tech-title-text">{t.techTitle}</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-8">
					{techStack.map(tech => (
						<div class="group border-l border-brand-border/30 pl-8 hover:border-brand-accent transition-all duration-500">
							<Icon name={tech.icon} class="text-brand-accent/40 mb-6 group-hover:text-brand-accent transition-colors" size={24} />
							<h3 class="font-serif text-xl mb-4 italic text-brand-text-main" id={`${tech.id}-title-text`}>{t[`${tech.id}Title`]}</h3>
							<p class="font-mono text-[11px] text-brand-text-muted leading-relaxed uppercase tracking-wider" id={`${tech.id}-desc-text`}>
								{t[`${tech.id}Desc`]}
							</p>
						</div>
					))}
				</div>
			</section>

			<!-- Certifications Section -->
			<section id="certifications" class="mt-32 border-t border-brand-border pt-20 pb-20">
				<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8 mb-12">
					<h2 class="font-mono text-[13px] tracking-[0.4em] text-brand-text-muted uppercase font-bold" id="cert-title-text">{t.certificationsTitle}</h2>
					<div class="flex items-center gap-6">
						<span class="text-[9px] text-brand-text-muted uppercase tracking-widest" id="view-profile-text">{t.viewProfile}</span>
						<a href="https://www.credly.com/users/enrique-m-talavera/badges#credly" target="_blank" class="text-[9px] tracking-widest text-brand-accent hover:text-brand-text-main uppercase transition-colors">CREDLY</a>
					</div>
				</div>
				
				<div class="grid grid-cols-2 md:grid-cols-4 gap-12">
					<div class="flex flex-col gap-6 group">
						<div class="flex items-center justify-between">
							<span class="text-[9px] text-brand-accent/40 uppercase tracking-[0.2em] font-mono">01</span>
							<div class="w-12 h-12 relative overflow-hidden group-hover:drop-shadow-[0_0_15px_rgba(96,165,250,0.5)] transition-all duration-500">
								<img src="https://images.credly.com/size/340x340/images/2d84e428-9078-49b6-a804-13c15383d0de/image.png" alt="AWS SAP" class="w-full h-full object-contain transition-all duration-500" />
							</div>
						</div>
						<span class="text-[11px] tracking-[0.1em] uppercase leading-relaxed text-brand-text-main font-bold group-hover:font-black group-hover:underline underline-offset-8 transition-all duration-500 decoration-brand-accent/40 group-hover:bg-brand-accent/5 px-2 py-1 -mx-2" id="cert1-text">{t.cert1}</span>
					</div>
					<div class="flex flex-col gap-6 group">
						<div class="flex items-center justify-between">
							<span class="text-[9px] text-brand-accent/40 uppercase tracking-[0.2em] font-mono">02</span>
							<div class="w-12 h-12 relative overflow-hidden group-hover:drop-shadow-[0_0_15px_rgba(96,165,250,0.5)] transition-all duration-500">
								<img src="https://images.credly.com/size/340x340/images/0e284c3f-5164-4b21-8660-0d84737941bc/image.png" alt="AWS SAA" class="w-full h-full object-contain transition-all duration-500" />
							</div>
						</div>
						<span class="text-[11px] tracking-[0.1em] uppercase leading-relaxed text-brand-text-main font-bold group-hover:font-black group-hover:underline underline-offset-8 transition-all duration-500 decoration-brand-accent/40 group-hover:bg-brand-accent/5 px-2 py-1 -mx-2" id="cert2-text">{t.cert2}</span>
					</div>
					<div class="flex flex-col gap-6 group">
						<div class="flex items-center justify-between">
							<span class="text-[9px] text-brand-accent/40 uppercase tracking-[0.2em] font-mono">03</span>
							<div class="w-12 h-12 relative overflow-hidden group-hover:drop-shadow-[0_0_15px_rgba(96,165,250,0.5)] transition-all duration-500">
								<img src="https://images.credly.com/size/340x340/images/b9feab85-1a43-4f6b-99a5-631b88d5461b/image.png" alt="AWS DVA" class="w-full h-full object-contain transition-all duration-500" />
							</div>
						</div>
						<span class="text-[11px] tracking-[0.1em] uppercase leading-relaxed text-brand-text-main font-bold group-hover:font-black group-hover:underline underline-offset-8 transition-all duration-500 decoration-brand-accent/40 group-hover:bg-brand-accent/5 px-2 py-1 -mx-2" id="cert3-text">{t.cert3}</span>
					</div>
					<div class="flex flex-col gap-6 group">
						<div class="flex items-center justify-between">
							<span class="text-[9px] text-brand-accent/40 uppercase tracking-[0.2em] font-mono">04</span>
							<div class="w-12 h-12 relative overflow-hidden group-hover:drop-shadow-[0_0_15px_rgba(96,165,250,0.5)] transition-all duration-500">
								<img src="https://images.credly.com/size/340x340/images/cc8adc83-1dc6-4d57-8e20-22171247e052/blob" alt="CKAD" class="w-full h-full object-contain transition-all duration-500" />
							</div>
						</div>
						<span class="text-[11px] tracking-[0.1em] uppercase leading-relaxed text-brand-text-main font-bold group-hover:font-black group-hover:underline underline-offset-8 transition-all duration-500 decoration-brand-accent/40 group-hover:bg-brand-accent/5 px-2 py-1 -mx-2" id="cert4-text">{t.cert4}</span>
					</div>
					<div class="flex flex-col gap-6 group">
						<div class="flex items-center justify-between">
							<span class="text-[9px] text-brand-accent/40 uppercase tracking-[0.2em] font-mono">05</span>
							<div class="w-12 h-12 relative overflow-hidden group-hover:drop-shadow-[0_0_15px_rgba(96,165,250,0.5)] transition-all duration-500">
								<img src="https://images.credly.com/size/340x340/images/3661e48f-ee1c-47fc-a474-b84fca370a19/Oracle-Certification-badge_OC-Professional600X600.png" alt="Oracle Java" class="w-full h-full object-contain transition-all duration-500" />
							</div>
						</div>
						<span class="text-[11px] tracking-[0.1em] uppercase leading-relaxed text-brand-text-main font-bold group-hover:font-black group-hover:underline underline-offset-8 transition-all duration-500 decoration-brand-accent/40 group-hover:bg-brand-accent/5 px-2 py-1 -mx-2" id="cert5-text">{t.cert5}</span>
					</div>
					<a href="https://www.credly.com/users/enrique-m-talavera/badges#credly" target="_blank" class="flex flex-col gap-6 group">
						<div class="flex items-center justify-between">
							<span class="text-[9px] text-brand-accent/40 uppercase tracking-[0.2em] font-mono">06</span>
							<div class="w-12 h-12 flex items-center justify-center text-brand-accent/20 group-hover:text-brand-accent transition-all duration-500">
								<Icon name="ph:medal-bold" size={32} />
							</div>
						</div>
						<span class="text-[11px] tracking-[0.1em] uppercase leading-relaxed text-brand-text-main font-bold group-hover:font-black group-hover:underline underline-offset-8 transition-all duration-500 decoration-brand-accent/40 group-hover:bg-brand-accent/5 px-2 py-1 -mx-2" id="cert-credly-text">{t.certCredly}</span>
					</a>
				</div>
			</section>
		</div>
	</main>
</Layout>

<script define:vars={{ translations, demos, techStack }}>
	// Fetch visitor count
	fetch('https://counter-visitors.kiquetal.workers.dev')
		.then(res => res.json())
		.then(data => {
			const countEl = document.getElementById('visitor-count');
			if (countEl) countEl.textContent = data.visitors;
		})
		.catch(() => {
			const countEl = document.getElementById('visitor-count');
			if (countEl) countEl.textContent = '—';
		});

	function setLanguage(lang) {
		const t = translations[lang];

		// Update text content
		const heroTitle = document.getElementById('hero-title');
		if (heroTitle) heroTitle.textContent = t.heroTitle;
		
		const heroTitleItalic = document.getElementById('hero-title-italic');
		if (heroTitleItalic) heroTitleItalic.textContent = t.heroTitleItalic;

		const heroTitleSuffix = document.getElementById('hero-title-suffix');
		if (heroTitleSuffix) heroTitleSuffix.textContent = t.heroTitleSuffix;

		const descriptionText = document.getElementById('description-text');
		if (descriptionText) descriptionText.textContent = t.description;

		const manifestoText = document.getElementById('manifesto-text');
		if (manifestoText) manifestoText.textContent = t.manifesto;

		const latestUpdateLabel = document.getElementById('latest-update-label');
		if (latestUpdateLabel) latestUpdateLabel.textContent = t.latestUpdate;

		const latestPostTitle = document.getElementById('latest-post-title');
		if (latestPostTitle) {
			latestPostTitle.textContent = lang === 'en' ? latestPostTitle.dataset.titleEn : latestPostTitle.dataset.titleEs;
		}

		const demosTitleText = document.getElementById('demos-title-text');
		if (demosTitleText) demosTitleText.textContent = t.demosTitle;

		const techTitleText = document.getElementById('tech-title-text');
		if (techTitleText) techTitleText.textContent = t.techTitle;

		const coreTitleText = document.getElementById('core-title-text');
		if (coreTitleText) {
			const span = coreTitleText.querySelector('span');
			coreTitleText.textContent = t.coreTitle;
			if (span) coreTitleText.prepend(span);
		}

		const coreJavaText = document.getElementById('core-java-text');
		if (coreJavaText) coreJavaText.textContent = t.coreJava;

		const coreGoText = document.getElementById('core-go-text');
		if (coreGoText) coreGoText.textContent = t.coreGo;

		const coreK8sText = document.getElementById('core-k8s-text');
		if (coreK8sText) coreK8sText.textContent = t.coreK8s;

		const coreAwsText = document.getElementById('core-aws-text');
		if (coreAwsText) coreAwsText.textContent = t.coreAws;

		const viewCertsText = document.getElementById('view-certs-text');
		if (viewCertsText) viewCertsText.textContent = t.viewCerts;

		// Dynamic update for demos
		demos.forEach(demo => {
			const titleEl = document.getElementById(`${demo.id}-title-text`);
			if (titleEl) titleEl.textContent = t[`${demo.id}Title`];
			
			const descEl = document.getElementById(`${demo.id}-desc-text`);
			if (descEl) descEl.textContent = t[`${demo.id}Desc`];
		});

		// Dynamic update for tech stack
		techStack.forEach(tech => {
			const titleEl = document.getElementById(`${tech.id}-title-text`);
			if (titleEl) titleEl.textContent = t[`${tech.id}Title`];
			
			const descEl = document.getElementById(`${tech.id}-desc-text`);
			if (descEl) descEl.textContent = t[`${tech.id}Desc`];
		});

		const certTitleText = document.getElementById('cert-title-text');
		if (certTitleText) certTitleText.textContent = t.certificationsTitle;

		const viewProfileText = document.getElementById('view-profile-text');
		if (viewProfileText) viewProfileText.textContent = t.viewProfile;

		const cert1Text = document.getElementById('cert1-text');
		if (cert1Text) cert1Text.textContent = t.cert1;

		const cert2Text = document.getElementById('cert2-text');
		if (cert2Text) cert2Text.textContent = t.cert2;

		const cert3Text = document.getElementById('cert3-text');
		if (cert3Text) cert3Text.textContent = t.cert3;

		const cert4Text = document.getElementById('cert4-text');
		if (cert4Text) cert4Text.textContent = t.cert4;

		const cert5Text = document.getElementById('cert5-text');
		if (cert5Text) cert5Text.textContent = t.cert5;

		const certCredlyText = document.getElementById('cert-credly-text');
		if (certCredlyText) certCredlyText.textContent = t.certCredly;
		
		const visitorsLabelText = document.getElementById('visitors-label-text');
		if (visitorsLabelText) visitorsLabelText.textContent = t.visitorsLabel;
	}

	// Listen to header language change
	window.addEventListener('languageChange', (e) => {
		setLanguage(e.detail.lang);
	});

	// Check for saved preference
	const savedLang = localStorage.getItem('preferred-lang');
	if (savedLang) {
		setLanguage(savedLang);
	}
</script>
