    title: "kiquetal — Resilience as a First-Class Citizen",
    heroTitle: "Resilience as a ",
    heroTitleItalic: "First-Class",
    heroTitleSuffix: " Citizen.",
    description: '"Everything fails, all the time." — Werner Vogels, CTO @ AWS. Engineering is the art of building systems that thrive in the presence of failure.',
    manifesto: "Systems Manifesto v.1.0",
    cta: "View Credentials",
    contact: "Contact Me",
    certificationsTitle: "Professional Certifications",
    viewProfile: "You can view my profile here -> ",
