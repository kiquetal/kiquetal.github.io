    demo1Desc: "Secure end-to-end encryption using Quarkus with envelope encryption.",
    demo5Title: "Speech-to-Text with Whisper and F#",
    demo5Desc: "Converting speech to text using OpenAI Whisper model implemented in F#.",
    demoLabel: "Live Demo",
    blogLabel: "Read Article",
    visitorsLabel: "visitors",
    techTitle: "Technical Arsenal",
