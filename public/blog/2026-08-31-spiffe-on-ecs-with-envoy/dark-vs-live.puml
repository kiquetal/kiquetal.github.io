@startuml dark-vs-live
title Proteus — Dark by Default vs Live After Admit

skinparam backgroundColor #0d1117
skinparam defaultFontColor #e6edf3
skinparam ArrowColor #58a6ff
skinparam roundCorner 12
skinparam shadowing false
skinparam rectangle {
  BorderColor #30363d
  FontColor #e6edf3
}

' ============ DARK ============
rectangle "🌑 DARK — not admitted (no workload entry)" as DARK #1a1a2e {
  rectangle "app :8080\n(Go)" as dApp #21262d
  rectangle "envoy\n:9903 egress" as dEnvoy #21262d
  rectangle "spire-agent\nSDS server" as dAgent #21262d
  rectangle "service-b\n:9902" as dPeer #3a1a1a

  dApp -[#58a6ff]-> dEnvoy : GET localhost:9903
  dEnvoy .[#f5a623].> dAgent : SDS: give me cert
  dAgent .[#e94560].> dEnvoy : X not authorized\n(no entry)
  dEnvoy -[#e94560]->x dPeer : X 503 UF\nSecret not supplied by SDS
}

' ============ ADMIT ============
rectangle "🚪 Gatekeeper admits\n(admission-controller creates SPIRE entry)" as ADMIT #f5a623

' ============ LIVE ============
rectangle "☀️ LIVE — admitted (workload entry exists)" as LIVE #16213e {
  rectangle "app :8080\n(Go)" as lApp #21262d
  rectangle "envoy\n:9903 egress" as lEnvoy #21262d
  rectangle "spire-agent\nSDS server" as lAgent #21262d
  rectangle "service-b\n:9902" as lPeer #1a3a1a

  lApp -[#58a6ff]-> lEnvoy : GET localhost:9903
  lAgent -[#0f9d58]-> lEnvoy : OK SVID pushed\nCreating X509-SVID
  lEnvoy -[#0f9d58]-> lPeer : OK 200 mTLS\npeer=spiffe://.../service-a
}

DARK -[#f5a623]-> ADMIT
ADMIT -[#0f9d58]-> LIVE

@enduml
