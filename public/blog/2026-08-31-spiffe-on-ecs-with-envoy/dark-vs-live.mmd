flowchart TB
    subgraph DARK["🌑 DARK — not admitted (no workload entry)"]
        direction TB
        dApp["app :8080<br/>(Go)"]
        dEnvoy["envoy<br/>:9903 egress"]
        dAgent["spire-agent<br/>SDS server"]
        dPeer["service-b<br/>:9902"]

        dApp -->|"GET localhost:9903"| dEnvoy
        dEnvoy -.->|"SDS: give me cert"| dAgent
        dAgent -.->|"❌ not authorized<br/>no entry"| dEnvoy
        dEnvoy x==>|"❌ 503 UF<br/>Secret not supplied by SDS"| dPeer
    end

    subgraph LIVE["☀️ LIVE — admitted (workload entry exists)"]
        direction TB
        lApp["app :8080<br/>(Go)"]
        lEnvoy["envoy<br/>:9903 egress"]
        lAgent["spire-agent<br/>SDS server"]
        lPeer["service-b<br/>:9902"]

        lApp -->|"GET localhost:9903"| lEnvoy
        lAgent -->|"✅ SVID pushed<br/>Creating X509-SVID"| lEnvoy
        lEnvoy ==>|"✅ 200 mTLS<br/>peer=spiffe://.../service-a"| lPeer
    end

    ADMIT["🚪 Gatekeeper admits<br/>(admission-controller<br/>creates SPIRE entry)"]
    DARK --> ADMIT --> LIVE

    style DARK fill:#1a1a2e,stroke:#e94560,color:#fff
    style LIVE fill:#16213e,stroke:#0f9d58,color:#fff
    style ADMIT fill:#f5a623,stroke:#333,color:#000
    style dPeer fill:#3a1a1a,stroke:#e94560,color:#fff
    style lPeer fill:#1a3a1a,stroke:#0f9d58,color:#fff
