@startuml
title Admission — proving WHICH SERVICE IDENTITY

participant "operator" as op #4A6B7C
participant "admission" as ac #C77D3A
participant "SPIRE Server" as server #2C3E4A
participant "SPIRE Agent" as agent #7A9BAE

op -> ac : POST /admit (service-a)
ac -> server : CreateEntry (spiffe id)
server --> ac : entry created
note over ac : now service-a is allowed

agent -> server : SDS: request SVID
alt entry exists
    server --> agent : X.509 SVID issued
else not admitted yet
    server --> agent : not authorized
end
@enduml
