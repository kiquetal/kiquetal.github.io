@startuml
title Node Attestation — proving WHICH TASK

participant "SPIRE Agent" as agent #4A6B7C
participant "SPIRE Server" as server #2C3E4A
participant "ECS API" as ecs #7A9BAE

agent -> server : attest (TaskARN, cluster, family)
note over server : proteus_ecs plugin does not trust the claim
server -> ecs : DescribeTasks(TaskARN)
ecs --> server : real TaskRoleARN

alt role allowed
    server --> agent : node SVID granted
else role denied
    server --> agent : PermissionDenied
end
@enduml
