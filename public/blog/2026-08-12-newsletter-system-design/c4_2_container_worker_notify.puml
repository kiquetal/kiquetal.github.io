@startuml C4_Level2_WorkerNotify
' =============================================================================
' C4 Level 2 — Container Diagram (worker-notify-subscriber)
' =============================================================================
' Shows the deployable units involved in the webhook notification flow:
' Resend (webhook emitter) → Cloudflare Worker → Resend (email sender) → Owner.
'
' AUDIENCE: Dev, DevOps — understanding the webhook notification pipeline.
' =============================================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' --- Layout ---
LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Container Diagram - worker-notify-subscriber (Webhook Notification Flow)

' =============================================================================
' PEOPLE
' =============================================================================

Person(owner, "Site Owner (kiquetal)", "Receives real-time notification emails when subscribers join, unsubscribe, update, or are deleted.")

' =============================================================================
' SYSTEM BOUNDARY — Notification Flow
' =============================================================================

System_Boundary(notify_system, "Webhook Notification Flow") {

    ' --- Cloudflare Worker ---
    Container(worker_notify, "worker-notify-subscriber", "Cloudflare Worker / JS", "Webhook endpoint for Resend contact events. Verifies Svix HMAC-SHA256 signature + timestamp replay protection. Routes events (contact.created, contact.updated, contact.deleted) and sends styled notification to owner.")
}

' =============================================================================
' EXTERNAL SYSTEMS
' =============================================================================

System_Ext(resend_webhooks, "Resend (Webhook Emitter)", "Fires signed HTTP POST events when contacts are created, updated, or deleted in the audience.")
System_Ext(resend_email, "Resend (Email Sender)", "Delivers notification emails via POST /emails API.")

' =============================================================================
' RELATIONSHIPS
' =============================================================================

' --- Resend → Worker (webhook) ---
Rel(resend_webhooks, worker_notify, "POST webhook payload (contact.created | contact.updated | contact.deleted)", "HTTPS (svix-id, svix-timestamp, svix-signature headers)")

' --- Worker → Resend (notification email) ---
Rel(worker_notify, resend_email, "Sends notification email to owner", "POST /emails (Bearer token)")

' --- Resend → Owner ---
Rel(resend_email, owner, "Delivers notification email (+NODE joined, -NODE disconnected, ✗NODE removed)", "Email/SMTP")

@enduml
