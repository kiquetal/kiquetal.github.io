@startuml C4_Level2_WorkerNewsletter
' =============================================================================
' C4 Level 2 — Container Diagram (worker-newsletter)
' =============================================================================
' Shows the deployable units involved in the weekly newsletter broadcast:
' GitHub Actions (cron) → Cloudflare Worker → KV State → Resend Broadcast → Subscribers.
'
' AUDIENCE: Dev, DevOps — understanding the weekly broadcast pipeline.
' =============================================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' --- Layout ---
LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Container Diagram - worker-newsletter (Weekly Broadcast Flow)

' =============================================================================
' PEOPLE
' =============================================================================

Person(subscribers, "Newsletter Subscribers", "Registered contacts who receive the weekly broadcast email every Wednesday if a new post exists.")

' =============================================================================
' SYSTEM BOUNDARY — Weekly Broadcast Flow
' =============================================================================

System_Boundary(broadcast_system, "Weekly Newsletter Broadcast") {

    ' --- GitHub Actions (trigger) ---
    Container(gh_action, "GitHub Actions Workflow", "GitHub Actions / Node.js", "Cron job every Wednesday 14:00 UTC. Parses blog frontmatter to find newest non-draft post, extracts slug + title + excerpt, POSTs metadata to worker.")

    ' --- Git Repository (content source) ---
    Container(repo, "Blog Content", "Git / src/content/blog/", "Markdown files with YAML frontmatter (title, excerpt, date, draft flag). Source of truth for blog posts.")

    ' --- Cloudflare Worker ---
    Container(worker_newsletter, "worker-newsletter", "Cloudflare Worker / JS", "Receives post metadata from GitHub Actions. Verifies shared secret. Checks KV for idempotency (skip if already sent). Builds bilingual HTML email and creates Resend Broadcast.")

    ' --- KV State ---
    ContainerDb(kv_state, "NEWSLETTER_STATE", "Cloudflare KV", "Key-value store holding newsletter:last_sent_slug. Ensures each post is broadcast only once (idempotency guard).")
}

' =============================================================================
' EXTERNAL SYSTEMS
' =============================================================================

System_Ext(resend, "Resend", "Email platform. Broadcast API creates and sends bulk emails to a segment of contacts. Handles delivery, tracking, and unsubscribe links.")
System_Ext(cloudflare, "Cloudflare Edge Network", "Runs the Worker + KV namespace. Manages secrets (RESEND_API_KEY, RESEND_SEGMENT_ID, NEWSLETTER_SECRET).")

' =============================================================================
' RELATIONSHIPS
' =============================================================================

' --- Cron trigger ---
Rel(gh_action, repo, "Reads blog posts, finds newest non-draft", "fs / checkout")

' --- GitHub Actions → Worker ---
Rel(gh_action, worker_newsletter, "POST {slug, titleEn, titleEs, excerptEn, excerptEs, postUrl}", "HTTPS/JSON (X-Newsletter-Secret header)")

' --- Worker → KV (idempotency check) ---
Rel(worker_newsletter, kv_state, "GET/PUT newsletter:last_sent_slug", "KV binding")

' --- Worker → Resend (broadcast) ---
Rel(worker_newsletter, resend, "Creates and sends broadcast to segment", "POST /broadcasts (Bearer token, send: true)")

' --- Resend → Subscribers ---
Rel(resend, subscribers, "Delivers weekly bilingual newsletter email", "Email/SMTP")

' --- Worker deployed on Cloudflare ---
Rel(worker_newsletter, cloudflare, "Deployed on", "wrangler deploy")

@enduml
