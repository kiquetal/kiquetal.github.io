@startuml C4_Level2_WorkerSubscribe
' =============================================================================
' C4 Level 2 — Container Diagram (worker-subscribe)
' =============================================================================
' Shows the deployable units involved in the subscription flow:
' Astro blog → Cloudflare Worker → Resend API → Subscriber.
'
' AUDIENCE: Dev, DevOps — understanding the subscribe pipeline.
' =============================================================================

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' --- Layout ---
LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Container Diagram - worker-subscribe (Subscription Flow)

' =============================================================================
' PEOPLE
' =============================================================================

Person(subscriber, "Blog Visitor", "Reads blog posts and subscribes to the newsletter via the subscription form.")

' =============================================================================
' SYSTEM BOUNDARY — Subscription Flow
' =============================================================================

System_Boundary(subscribe_system, "Subscription Flow") {

    ' --- Static Site (frontend) ---
    Container(astro_site, "Astro Blog", "Astro / GitHub Pages", "Static site with subscription form on blog pages. Collects email and language preference (en/es).")

    ' --- Cloudflare Worker ---
    Container(worker_subscribe, "worker-subscribe", "Cloudflare Worker / JS", "Validates origin (CORS allowlist), parses email + language, adds contact to Resend Audience, and fires async welcome email via ctx.waitUntil.")
}

' =============================================================================
' EXTERNAL SYSTEMS
' =============================================================================

System_Ext(resend, "Resend", "Email platform. Manages audience/contacts (POST /audiences/{id}/contacts) and sends transactional emails (POST /emails).")
System_Ext(cloudflare, "Cloudflare Edge Network", "Runs the Worker at edge locations globally. Manages secrets (RESEND_API_KEY, RESEND_AUDIENCE_ID) via environment bindings.")

' =============================================================================
' RELATIONSHIPS
' =============================================================================

' --- Visitor → Astro (reads content) ---
Rel(subscriber, astro_site, "Reads blog posts, sees subscription form", "HTTPS")

' --- Visitor → Worker (form submission goes directly to Cloudflare) ---
Rel(subscriber, worker_subscribe, "Submits email + language from form", "POST HTTPS/JSON (fetch from browser)")

' --- Worker → Resend (add contact) ---
Rel(worker_subscribe, resend, "Adds contact to audience", "POST /audiences/{id}/contacts (Bearer token)")

' --- Worker → Resend (welcome email) ---
Rel(worker_subscribe, resend, "Sends welcome email (async, ctx.waitUntil)", "POST /emails (Bearer token)")

' --- Resend → Subscriber ---
Rel(resend, subscriber, "Delivers i18n welcome email", "Email/SMTP")

' --- Worker deployed on Cloudflare ---
Rel(worker_subscribe, cloudflare, "Deployed on", "wrangler deploy")

@enduml
